        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oszacowano opłatę (wejścia ograniczone do wybranego podadresu)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Комісію оцінено (входи обмежено вибраною підадресою)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
