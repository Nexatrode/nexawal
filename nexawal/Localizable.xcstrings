          "stringUnit" : {
            "state" : "translated",
            "value" : "Məbləğ maksimum sərf edilə bilən məbləğə təyin edildi. Son komissiya göndərmə vaxtı bir qədər dəyişə bilər."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сумата е зададена на максимално разполагаемата. Крайната такса може да се промени леко при изпращане."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পরিমাণ সর্বোচ্চ ব্যয়যোগ্য পরিমাণে সেট করা হয়েছে। পাঠানোর সময় চূড়ান্ত ফি কিছুটা পরিবর্তিত হতে পারে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'import s'ha establert al màxim gastable. La comissió final pot canviar lleugerament en el moment d'enviar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Částka nastavena na maximum k odeslání. Konečný poplatek se může při odeslání mírně změnit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beløb sat til maks. disponibelt. Det endelige gebyr kan ændre sig lidt ved afsendelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betrag auf den maximal verfügbaren Wert gesetzt. Die endgültige Gebühr kann beim Senden leicht abweichen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το ποσό ορίστηκε στο μέγιστο διαθέσιμο για δαπάνη. Η τελική προμήθεια μπορεί να αλλάξει ελαφρώς κατά την αποστολή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amount set to max spendable. Final fee may change slightly at send time."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sumo agordita al la maksimuma elspezebla. La fina krompago povas iomete ŝanĝiĝi je la momento de sendo."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cantidad fijada al máximo gastable. La comisión final puede variar un poco al enviar."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Summa määrati maksimaalseks kulutatavaks summaks. Lõplik tasu võib saatmise ajal veidi muutuda."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopurua gehienezko gastagarrira ezarrita. Azken komisioa apur bat aldatu daiteke bidaltzeko unean."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مقدار روی حداکثر قابل خرج تنظیم شد. کارمزد نهایی ممکن است هنگام ارسال کمی تغییر کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Määrä asetettu suurimpaan käytettävissä olevaan summaan. Lopullinen maksu voi muuttua hieman lähetyshetkellä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Itinakda ang halaga sa pinakamalaking magagamit. Maliit na magbabago ang huling bayad sa oras ng pagpadala."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Montant réglé sur le maximum disponible. Les frais définitifs peuvent légèrement varier au moment de l'envoi."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Socraíodh an méid ag an uasmhéid inchaite. Féadfaidh an táille chríochnaithe athrú beagán ag am an seolta."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cantidade establecida no máximo gastable. A comisión final pode variar lixeiramente no momento do envío."
          }
        },
        "gn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cantidad oñemoĩ máximo emondo hag̃uáicha. Comisión paha ikatu oñemyengovia mbykymi emondo jave."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An saita adadin zuwa mafi girman da za a iya kashewa. Kuɗin caji na ƙarshe na iya canzawa kaɗan lokacin aikawa."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הסכום הוגדר לסכום המרבי הניתן לשליחה. העמלה הסופית עשויה להשתנות מעט בזמן השליחה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "राशि अधिकतम व्यय-योग्य राशि पर सेट की गई। भेजते समय अंतिम फ़ीस में थोड़ा बदलाव हो सकता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iznos je postavljen na maksimalan iznos koji se može potrošiti. Konačna naknada može se malo promijeniti u trenutku slanja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az összeg a maximálisan elkölthetőre lett állítva. A végső díj küldéskor kissé változhat."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Գումարը սահմանվեց առավելագույն ծախսելի արժեքին։ Վերջնական միջնորդավճարը կարող է թեթևակի փոփոխվել ուղարկման պահին։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jumlah diatur ke maksimum yang dapat dibelanjakan. Biaya akhir dapat sedikit berubah saat pengiriman."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importo impostato al massimo spendibile. La commissione finale potrebbe variare leggermente al momento dell'invio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "金額を送金可能な最大額に設定しました。送金時に最終的な手数料が若干変わる場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "금액이 최대 지출 가능액으로 설정되었습니다. 전송 시 최종 수수료가 약간 달라질 수 있습니다."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сумма чыгымдалуучу эң чоң суммага коюлду. Акыркы комиссия жөнөтүү учурунда бир аз өзгөрүшү мүмкүн."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suma nustatyta į didžiausią išleidžiamą sumą. Galutinis mokestis siuntimo metu gali nežymiai pasikeisti."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Summa iestatīta uz maksimālo tērējamo summu. Galīgā maksa sūtīšanas laikā var nedaudz mainīties."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jumlah ditetapkan kepada maksimum yang boleh dibelanjakan. Yuran akhir mungkin berubah sedikit pada masa penghantaran."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ပမာဏကို အသုံးပြုနိုင်သော အများဆုံးသို့ သတ်မှတ်ထားသည်။ ပို့ချိန်တွင် နောက်ဆုံး အခကြေးငွေ အနည်းငယ် ပြောင်းလဲနိုင်သည်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beløpet er satt til maks som kan sendes. Den endelige avgiften kan endres litt ved sendetidspunktet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bedrag ingesteld op maximaal besteedbaar. De uiteindelijke vergoeding kan iets afwijken bij verzending."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kwota ustawiona na maksymalną możliwą do wysłania. Ostateczna opłata może się nieznacznie zmienić w momencie wysyłki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valor definido para o máximo disponível. A taxa final pode variar um pouco no momento do envio."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suma a fost setată la maximul disponibil. Comisionul final se poate schimba puțin la momentul trimiterii."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сумма установлена на максимально доступную для отправки. Итоговая комиссия может немного измениться в момент отправки."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suma nastavená na maximum na odoslanie. Konečný poplatok sa môže pri odoslaní mierne zmeniť."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Znesek nastavljen na največji razpoložljivi znesek. Končna provizija se lahko ob pošiljanju malo spremeni."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shuma u caktua në maksimumin e shpenzueshëm. Tarifa përfundimtare mund të ndryshojë pak në momentin e dërgimit."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beloppet är satt till max spenderbart. Den slutliga avgiften kan ändras något vid sändning."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตั้งจำนวนเป็นยอดสูงสุดที่ใช้ได้ ค่าธรรมเนียมสุดท้ายอาจเปลี่ยนแปลงเล็กน้อยขณะส่ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miktar, harcanabilir maksimuma ayarlandı. Nihai ücret gönderim sırasında hafifçe değişebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Суму встановлено на максимальну доступну для витрати. Кінцева комісія може дещо змінитися під час надсилання."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رقم زیادہ سے زیادہ خرچ کے قابل مقدار پر سیٹ کر دی گئی ہے۔ ترسیل کے وقت حتمی فیس میں معمولی تبدیلی ہو سکتی ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Số tiền đã được đặt ở mức tối đa có thể chi tiêu. Phí cuối cùng có thể thay đổi nhẹ khi gửi."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A ti ṣètò iye sí ìwọ̀n tí ó pọ̀ jùlọ tí a lè fi ránṣẹ́. Ọya ìkẹyìn lè yí padà díẹ̀ ní àkókò fífiránṣẹ́."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "金额已设为最大可用金额。发送时最终手续费可能略有变化。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "金額已設爲最大可用金額。發送時最終手續費可能略有變化。"
