        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manage node access, device security, and recovery behavior."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Administru nodan atingon, aparatan sekurecon kaj restaŭran konduton."
