            "state": "translated",
            "value": "Las palabras aún no coinciden."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sõnad ei klapi veel."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hitzak ez datoz oraindik bat."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کلمه(ها) هنوز مطابقت ندارند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sana(t) eivät täsmää vielä."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi pa tugma ang (mga) salita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mots ne correspondent pas encore."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Níl na focail ag teacht le chéile fós."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "As palabras aínda non coinciden."
          }
        },
        "gn": {
          "stringUnit": {
            "state": "translated",
            "value": "Umi ñe'ẽ ndojojahái gueteri."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalma(kalmomi) ba su dace ba tukuna."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המילה (או המילים) עדיין לא תואמות."
