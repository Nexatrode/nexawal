            "value": "Za zaščito denarnice lahko uporabiš Face ID."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID-t használhatsz a pénztárcád védelmére."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Galite naudoti Face ID savo piniginei apsaugoti."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūs varat izmantot Face ID, lai aizsargātu savu maku."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ اپنے والٹ کو محفوظ بنانے کے لیے Face ID استعمال کر سکتے ہیں۔"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit käyttää Face ID:tä lompakkosi suojaamiseen."
          }
        }
      }
    },
