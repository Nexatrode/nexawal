          "stringUnit": {
            "state": "translated",
            "value": "Il saldo si aggiorna durante il completamento della sincronizzazione"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Saldo wordt bijgewerkt terwijl synchronisatie wordt ingehaald"
