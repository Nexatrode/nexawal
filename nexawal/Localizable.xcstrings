        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Senkronizasyon tamamlanırken bakiye güncelleniyor"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिंक पूरा होने तक बैलेंस अपडेट हो रहा है"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同步追趕進度中,餘額更新中"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Saldo aktualizuje się w trakcie synchronizacji"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Баланс оновлюється, доки триває синхронізація"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Số dư đang cập nhật trong khi đồng bộ hóa hoàn tất"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยอดคงเหลือกำลังอัปเดตขณะรอการซิงค์ให้ทันข้อมูล"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "موجودی در حال به‌روزرسانی است تا همگام‌سازی کامل شود"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zůstatek se aktualizuje, dokud synchronizace nedoběhne"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Балансът се актуализира, докато синхронизацията се доизпълни"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Saldot uppdateras medan synkroniseringen kommer i kapp"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Soldul se actualizează în timp ce sincronizarea recuperează întârzierea"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Saldoen oppdateres mens synkroniseringen tar igjen"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم تحديث الرصيد أثناء استكمال المزامنة"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "היתרה מתעדכנת בזמן שהסנכרון משלים פיגור"
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "Iye owó ń yí padà nígbà tí ìṣọ̀kan ń tẹ̀síwájú"
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nag-a-update ang balanse habang naka-catch up ang sync"
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ထပ်တူညှိမှု မီအောင်လုပ်နေစဉ် လက်ကျန်ငွေ ပြင်ဆင်နေသည်"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Baki sedang dikemas kini semasa penyelarasan mengejar ketinggalan"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinxronizasiya çatana qədər balans yenilənir"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সিঙ্ক ধরার সময় ব্যালেন্স আপডেট হচ্ছে"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stanje se posodablja, medtem ko sinhronizacija dohiteva"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az egyenleg frissül, amíg a szinkronizálás felzárkózik"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Likutis atnaujinamas, kol vyksta sinchronizavimas"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Atlikums tiek atjaunināts, kamēr sinhronizācija panāk"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سنک مکمل ہونے تک بیلنس اپڈیٹ ہو رہا ہے"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Saldo päivittyy synkronoinnin edetessä"
          }
        }
      }
    },
    "Biometric authentication is available, but no biometric data is enrolled.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die biometrische Authentifizierung ist verfügbar, aber es sind keine biometrischen Daten hinterlegt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Biometric authentication is available, but no biometric data is enrolled."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La autenticación biométrica está disponible, pero no hay datos biométricos registrados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'authentification biométrique est disponible, mais aucune donnée biométrique n'est enregistrée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "生体認証は利用可能ですが、生体情報が登録されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "생체 인증을 사용할 수 있지만 등록된 생체 정보가 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A autenticação biométrica está disponível, mas nenhum dado biométrico foi cadastrado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Биометрическая аутентификация доступна, но биометрические данные не настроены."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备支持生物识别验证,但尚未录入生物识别信息。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'autenticazione biometrica è disponibile, ma non sono stati registrati dati biometrici."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Biometrische verificatie is beschikbaar, maar er zijn geen biometrische gegevens geregistreerd."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Autentikasi biometrik tersedia, tetapi tidak ada data biometrik yang terdaftar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Biyometrik kimlik doğrulama kullanılabilir, ancak kayıtlı biyometrik veri yok."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बायोमेट्रिक प्रमाणीकरण उपलब्ध है, लेकिन कोई बायोमेट्रिक डेटा दर्ज नहीं है।"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此設備支持生物識別驗證,但尚未錄入生物識別信息。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uwierzytelnianie biometryczne jest dostępne, ale nie zarejestrowano żadnych danych biometrycznych."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Біометрична автентифікація доступна, але біометричні дані не зареєстровано."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xác thực sinh trắc học khả dụng, nhưng chưa có dữ liệu sinh trắc học nào được đăng ký."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การยืนยันตัวตนด้วยไบโอเมตริกพร้อมใช้งาน แต่ยังไม่มีการลงทะเบียนข้อมูลไบโอเมตริก"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "احراز هویت بیومتریک در دسترس است، اما هیچ داده بیومتریکی ثبت نشده است."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Biometrické ověření je k dispozici, ale nejsou zaregistrovány žádné biometrické údaje."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Биометричното удостоверяване е достъпно, но няма регистрирани биометрични данни."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Biometrisk autentisering är tillgänglig, men ingen biometrisk data är registrerad."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Autentificarea biometrică este disponibilă, dar nu sunt înregistrate date biometrice."
          }
        },
        "nb": {
