    "Device authentication is required but unavailable. Enable biometrics or a screen lock, then retry.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Geräteauthentifizierung ist erforderlich, aber nicht verfügbar. Aktiviere Biometrie oder eine Bildschirmsperre und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device authentication is required but unavailable. Enable biometrics or a screen lock, then retry."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se requiere autenticación del dispositivo, pero no está disponible. Activa la biometría o un bloqueo de pantalla e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'authentification de l'appareil est requise mais indisponible. Active la biométrie ou un verrouillage d'écran, puis réessaie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイス認証が必要ですが利用できません。生体認証または画面ロックを有効にしてから再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 인증이 필요하지만 사용할 수 없습니다. 생체 인증 또는 화면 잠금을 활성화한 후 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A autenticação do dispositivo é necessária, mas está indisponível. Ative a biometria ou um bloqueio de tela e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Требуется аутентификация устройства, но она недоступна. Включите биометрию или блокировку экрана и попробуйте снова."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要设备身份验证,但当前不可用。请启用生物识别或屏幕锁定后重试。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'autenticazione del dispositivo è richiesta ma non disponibile. Attiva la biometria o un blocco schermo, poi riprova."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apparaatverificatie is vereist maar niet beschikbaar. Schakel biometrie of een schermvergrendeling in en probeer het opnieuw."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Autentikasi perangkat diperlukan tetapi tidak tersedia. Aktifkan biometrik atau kunci layar, lalu coba lagi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cihaz kimlik doğrulaması gerekli ama kullanılamıyor. Biyometrikleri veya ekran kilidini etkinleştirip tekrar deneyin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डिवाइस प्रमाणीकरण आवश्यक है लेकिन उपलब्ध नहीं है। बायोमेट्रिक्स या स्क्रीन लॉक सक्षम करें, फिर पुनः प्रयास करें।"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要設備身份驗證,但當前不可用。請啓用生物識別或屏幕鎖定後重試。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wymagane jest uwierzytelnienie urządzenia, ale jest niedostępne. Włącz biometrię lub blokadę ekranu, a następnie spróbuj ponownie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Потрібна автентифікація пристрою, але вона недоступна. Увімкніть біометрію або блокування екрана та спробуйте ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần xác thực thiết bị nhưng không khả dụng. Hãy bật sinh trắc học hoặc khóa màn hình, sau đó thử lại."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต้องยืนยันตัวตนของอุปกรณ์ แต่ไม่พร้อมใช้งาน กรุณาเปิดใช้ไบโอเมตริกหรือการล็อกหน้าจอ แล้วลองใหม่"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "احراز هویت دستگاه لازم است اما در دسترس نیست. بیومتریک یا قفل صفحه را فعال کنید و دوباره تلاش کنید."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Je nutné ověření zařízení, ale není k dispozici. Povolte biometrii nebo zámek obrazovky a zkuste to znovu."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изисква се удостоверяване на устройството, но то е недостъпно. Активирайте биометрия или заключване на екрана и опитайте отново."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Enhetsautentisering krävs men är inte tillgänglig. Aktivera biometri eller skärmlås och försök igen."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Autentificarea dispozitivului este necesară, dar indisponibilă. Activează datele biometrice sau un blocaj de ecran, apoi încearcă din nou."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Enhetsautentisering er nødvendig, men utilgjengelig. Aktiver biometri eller skjermlås, og prøv igjen."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مصادقة الجهاز مطلوبة لكنها غير متاحة. فعّل البيانات البيومترية أو قفل الشاشة، ثم أعد المحاولة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אימות מכשיר נדרש אך אינו זמין. הפעל אימות ביומטרי או נעילת מסך, ואז נסה שוב."
          }
        }
      }
    },
