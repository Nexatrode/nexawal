            "value": "Сакталган капчыктын метадайынын окуу ишке ашпады"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Leximi i metadatave të ruajtura të portofolit dështoi"
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
