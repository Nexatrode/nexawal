    "Controls how many Monero accounts are scanned starting at account 0.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestimmt, wie viele Monero-Konten ab Konto 0 gescannt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Controls how many Monero accounts are scanned starting at account 0."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Controla cuántas cuentas Monero se escanean desde la cuenta 0."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définit le nombre de comptes Monero analysés à partir du compte 0."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウント0から開始してスキャンするMoneroアカウントの数を制御します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정 0부터 스캔할 Monero 계정 수를 제어합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Controla quantas contas Monero são varridas a partir da conta 0."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Определяет, сколько аккаунтов Monero сканируется, начиная с аккаунта 0."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "控制从账户 0 开始扫描的 Monero 账户数量。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla quanti account Monero vengono scansionati a partire dall'account 0."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bepaalt hoeveel Monero-accounts worden gescand, vanaf account 0."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengatur berapa banyak akun Monero yang dipindai mulai dari akun 0."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "0. hesaptan başlayarak kaç Monero hesabının taranacağını denetler."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह नियंत्रित करता है कि अकाउंट 0 से शुरू करके कितने Monero अकाउंट स्कैन किए जाएं।"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "控制從賬戶 0 開始掃描的 Monero 賬戶數量。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Określa, ile kont Monero jest skanowanych, zaczynając od konta 0."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Визначає, скільки облікових записів Monero скануються, починаючи з облікового запису 0."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiểm soát số tài khoản Monero được quét, bắt đầu từ tài khoản 0."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำหนดจำนวนบัญชี Monero ที่จะสแกน โดยเริ่มจากบัญชีที่ 0"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تعیین می‌کند چند حساب Monero، با شروع از حساب 0، اسکن شوند."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Určuje, kolik účtů Monero se skenuje počínaje účtem 0."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Определя колко сметки на Monero се сканират, като се започва от сметка 0."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Styr hur många Monero-konton som skannas med start från konto 0."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlează câte conturi Monero sunt scanate începând cu contul 0."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Styrer hvor mange Monero-kontoer som skannes fra konto 0."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتحكم في عدد حسابات Monero التي يتم مسحها بدءًا من الحساب 0."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קובע כמה חשבונות Monero נסרקים החל מחשבון 0."
          }
        }
      }
    },
