          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk Segarkan Dompet untuk melanjutkan (atau buka ulang aplikasi)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Devam etmek için Cüzdanı Yenile'ye dokunun (veya uygulamayı yeniden açın)."
