    "A new receive address (subaddress) will be generated for privacy.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A new receive address (subaddress) will be generated for privacy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se generará una nueva dirección de recepción (subdirección) por privacidad."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um novo endereço de recebimento (subendereço) será gerado para maior privacidade."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为了保护隐私,将生成一个新的接收地址(子地址)。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для повышения приватности будет создан новый адрес получения (подадрес)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für mehr Privatsphäre wird eine neue Empfangsadresse (Unteradresse) erstellt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une nouvelle adresse de réception (sous-adresse) sera générée pour préserver la confidentialité."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プライバシー保護のため、新しい受取用アドレス(サブアドレス)が生成されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개인정보 보호를 위해 새 수신 주소(서브주소)가 생성됩니다."
          }
        }
      }
    },
    "A send is already in progress. Wait for it to finish.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A send is already in progress. Wait for it to finish."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya hay un envío en curso. Espera a que termine."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um envio já está em andamento. Aguarde a conclusão."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已有一笔发送正在进行,请等待其完成。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправка уже выполняется. Подождите её завершения."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Sendetransaktion läuft bereits. Bitte warte, bis sie abgeschlossen ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un envoi est déjà en cours. Attends qu'il se termine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送金処理が既に進行中です。完了までお待ちください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 전송이 진행 중입니다. 완료될 때까지 기다려 주세요."
          }
        }
      }
    },
    "A wallet is already stored on this device.": {
      "extractionState": "stale",
      "localizations": {
