    "Wallet must be unlocked before changing biometric protection.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Wallet muss entsperrt sein, bevor der biometrische Schutz geändert werden kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wallet must be unlocked before changing biometric protection."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Debes desbloquear la cartera antes de cambiar la protección biométrica."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le portefeuille doit être déverrouillé avant de modifier la protection biométrique."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "生体認証保護を変更する前にウォレットのロックを解除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "생체 인증 보호를 변경하려면 먼저 지갑 잠금을 해제해야 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A carteira precisa estar desbloqueada antes de alterar a proteção biométrica."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед изменением биометрической защиты кошелёк должен быть разблокирован."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改生物识别保护设置前须先解锁钱包。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il wallet deve essere sbloccato prima di modificare la protezione biometrica."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wallet moet ontgrendeld zijn voordat je de biometrische beveiliging wijzigt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dompet harus dibuka kuncinya sebelum mengubah proteksi biometrik."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Biyometrik korumayı değiştirmeden önce cüzdanın kilidi açılmalıdır."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बायोमेट्रिक सुरक्षा बदलने से पहले वॉलेट को अनलॉक करना आवश्यक है।"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更改生物識別保護設置前須先解鎖錢包。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Portfel musi być odblokowany, aby zmienić ochronę biometryczną."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Гаманець потрібно розблокувати перед зміною біометричного захисту."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ví phải được mở khóa trước khi thay đổi bảo vệ sinh trắc học."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต้องปลดล็อกกระเป๋าเงินก่อนเปลี่ยนการป้องกันไบโอเมตริก"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیش از تغییر محافظت بیومتریک، قفل کیف پول باید باز شود."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Peněženka musí být odemčena, než změníte biometrickou ochranu."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Портфейлът трябва да бъде отключен, преди да промените биометричната защита."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Plånboken måste låsas upp innan biometriskt skydd ändras."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Portofelul trebuie deblocat înainte de a schimba protecția biometrică."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lommeboken må låses opp før du endrer biometrisk beskyttelse."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب فتح المحفظة قبل تغيير الحماية البيومترية."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לפתוח את הארנק לפני שינוי ההגנה הביומטרית."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "Àpamọ́wọ́ gbọ́dọ̀ ṣí sílẹ̀ kí o tó yí ààbò Biometric padà."
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dapat na-unlock ang wallet bago baguhin ang proteksyong biometric."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "Biometric ကာကွယ်မှုကို ပြောင်းလဲမီ ပိုက်ဆံအိတ်ကို ဖွင့်ထားရမည်။"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dompet mesti dibuka kuncinya sebelum menukar perlindungan biometrik."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Biometrik qorumayı dəyişməzdən əvvəl pulqabı açılmış olmalıdır."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বায়োমেট্রিক প্রোটেকশন পরিবর্তন করার আগে ওয়ালেট আনলক করা থাকতে হবে।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Denarnica mora biti odklenjena, preden spremeniš biometrično zaščito."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A pénztárcát fel kell oldani a biometrikus védelem módosítása előtt."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Prieš keičiant biometrinę apsaugą, piniginė turi būti atrakinta."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pirms biometriskās aizsardzības mainīšanas makam jābūt atbloķētam."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بایومیٹرک تحفظ تبدیل کرنے سے پہلے والٹ کا ان لاک ہونا ضروری ہے۔"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lompakon lukitus on avattava ennen biometrisen suojauksen muuttamista."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La cartera ha d'estar desbloquejada abans de canviar la protecció biomètrica."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Novčanik mora biti otključan prije promjene biometrijske zaštite."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Peňaženka musí byť odomknutá, než zmeníte biometrickú ochranu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegnebogen skal låses op, før biometrisk beskyttelse kan ændres."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το πορτοφόλι πρέπει να ξεκλειδωθεί πριν αλλάξετε τη βιομετρική προστασία."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Rahakott peab olema lahti lukustatud enne biomeetrilise kaitse muutmist."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Zorroa desblokeatu behar da babes biometrikoa aldatu aurretik."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Ní mór an sparán a dhíghlasáil sula n-athraítear an chosaint bithmhéadrach."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "A carteira debe estar desbloqueada antes de cambiar a protección biométrica."
          }
        },
        "gn": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekotevẽ eipe'a ñongatuha mboyve emyengovia protección biométrica."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Dole a buɗe walat kafin canza kariyar halittar jiki."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Դրամապանակը պետք է բացակողպված լինի, նախքան կենսաչափական պաշտպանության փոփոխումը։"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Биометрикалык корголуусун өзгөртүүдөн мурун капчык ачылган болушу керек."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Portofoli duhet të zhbllokohet para se të ndryshohet mbrojtja biometrike."
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Monujo devas esti malŝlosita antaŭ ŝanĝo de biometria protekto."
          }
        }
      }
    },
