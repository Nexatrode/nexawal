    "NexaWal needs camera access to scan QR codes for sending Monero.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "NexaWal benötigt Kamerazugriff, um QR-Codes zum Senden von Monero zu scannen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NexaWal needs camera access to scan QR codes for sending Monero."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "NexaWal necesita acceso a la cámara para escanear códigos QR al enviar Monero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "NexaWal a besoin d'accéder à la caméra pour scanner les codes QR lors de l'envoi de Monero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "NexaWalはMoneroを送金するためのQRコードをスキャンするのにカメラへのアクセスが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Monero를 전송하기 위해 QR 코드를 스캔하려면 NexaWal에 카메라 접근 권한이 필요합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O NexaWal precisa de acesso à câmera para escanear códigos QR ao enviar Monero."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "NexaWal нужен доступ к камере для сканирования QR-кодов при отправке Monero."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "NexaWal 需要访问相机以扫描用于发送 Monero 的 QR 码。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "NexaWal necessita dell'accesso alla fotocamera per scansionare i codici QR per l'invio di Monero."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "NexaWal heeft cameratoegang nodig om QR-codes te scannen voor het verzenden van Monero."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "NexaWal membutuhkan akses kamera untuk memindai kode QR guna mengirim Monero."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "NexaWal, Monero göndermek için QR kodlarını taramak amacıyla kamera erişimine ihtiyaç duyar."
          }
        }
      }
    },
