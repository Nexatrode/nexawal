    "A new receive address (subaddress) will be generated for privacy.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für mehr Privatsphäre wird eine neue Empfangsadresse (Unteradresse) erstellt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A new receive address (subaddress) will be generated for privacy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se generará una nueva dirección de recepción (subdirección) por privacidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une nouvelle adresse de réception (sous-adresse) sera générée pour préserver la confidentialité."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プライバシー保護のため、新しい受取用アドレス(サブアドレス)が生成されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개인정보 보호를 위해 새 수신 주소(서브주소)가 생성됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um novo endereço de recebimento (subendereço) será gerado para maior privacidade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для повышения приватности будет создан новый адрес получения (подадрес)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为了保护隐私,将生成一个新的接收地址(子地址)。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrà generato un nuovo indirizzo di ricezione (sottoindirizzo) per la privacy."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er wordt een nieuw ontvangstadres (subadres) gegenereerd voor privacy."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Alamat terima baru (subalamat) akan dibuat untuk privasi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gizlilik için yeni bir alım adresi (alt adres) oluşturulacak."
          }
        }
      }
    },
