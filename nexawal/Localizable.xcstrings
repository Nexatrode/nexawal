    "Preview the fee before sending to %@.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عاين الرسوم قبل الإرسال إلى %@."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-ə göndərmədən əvvəl komissiyaya baxın."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Прегледайте таксата, преди да изпратите към %@."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-এ পাঠানোর আগে ফি প্রিভিউ দেখুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Previsualitza la comissió abans d'enviar a %@."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Před odesláním na %@ zobrazte náhled poplatku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forhåndsvis gebyret, før du sender til %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh dir die Gebühr an, bevor du an %@ sendest."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προεπισκόπηση της προμήθειας πριν από την αποστολή στο %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preview the fee before sending to %@."
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Antaŭrigardu la krompagon antaŭ sendo al %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Previsualiza la comisión antes de enviar a %@."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaadake tasu eelvaadet enne %@-le saatmist."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Aurreikusi komisioa bidali aurretik (hartzailea: %@)."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "قبل از ارسال به %@، کارمزد را پیش‌نمایش کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Esikatsele maksu ennen lähettämistä osoitteeseen %@."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-preview ang bayad bago magpadala sa %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifie les frais avant d'envoyer à %@."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Faigh réamhamharc ar an táille sula seolann tú chuig %@."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Previsualiza a comisión antes de enviar a %@."
          }
        },
        "gn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ehecha mboyve comisión emondo mboyve %@-pe."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Duba kuɗin caji kafin aikawa zuwa %@."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הצג תצוגה מקדימה של העמלה לפני השליחה אל %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ को भेजने से पहले फ़ीस का पूर्वावलोकन करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregledajte naknadu prije slanja na %@."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nézd meg a díj előnézetét, mielőtt küldesz ide: %@."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Նախադիտեք միջնորդավճարը մինչև %@-ին ուղարկելը։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pratinjau biaya sebelum mengirim ke %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Visualizza l'anteprima della commissione prima di inviare a %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ への送金前に手数料を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@로 보내기 전에 수수료를 미리 확인하세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-ге жөнөтүүдөн мурун комиссияны алдын ала көрүңүз."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Peržiūrėkite mokestį prieš siunčiant į %@."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Priekšskatiet maksu, pirms sūtāt uz %@."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pratonton yuran sebelum menghantar kepada %@."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ သို့ ပို့ခြင်းမပြုမီ အခကြေးငွေကို အစမ်းကြည့်ပါ။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Forhåndsvis avgiften før du sender til %@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekijk de vergoeding voordat je verzendt naar %@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź opłatę przed wysłaniem do %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Visualize a taxa antes de enviar para %@."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Previzualizează comisionul înainte de a trimite la %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Просмотрите комиссию перед отправкой на %@."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pred odoslaním na %@ zobrazte náhľad poplatku."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pred pošiljanjem na %@ si oglej predogled provizije."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Shiko paraprakisht tarifën para se t'ia dërgosh %@."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förhandsgranska avgiften innan du skickar till %@."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดูตัวอย่างค่าธรรมเนียมก่อนส่งไปยัง %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ adresine göndermeden önce ücreti önizleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перегляньте комісію перед надсиланням до %@."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ کو بھیجنے سے پہلے فیس کا پیش منظر دیکھیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem trước phí trước khi gửi tới %@."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "Wo ọya ṣáájú kí o tó fi ránṣẹ́ sí %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在发送到 %@ 前先预览手续费。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在發送到 %@ 前先預覽手續費。"
          }
        }
      }
    },
