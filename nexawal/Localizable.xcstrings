    "Choose whether you're creating a brand new wallet (fast sync) or importing an existing wallet (full scan unless you set a restore height).": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر ما إذا كنت تنشئ محفظة جديدة تمامًا (مزامنة سريعة) أو تستورد محفظة موجودة (مسح كامل إلا إذا حددت ارتفاع استعادة)."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamamilə yeni pulqabı yaratdığınızı (tez sinxronizasiya) və ya mövcud pulqabını idxal etdiyinizi (bərpa hündürlüyü təyin etməsəniz tam skan) seçin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изберете дали създавате изцяло нов портфейл (бърза синхронизация) или импортирате съществуващ портфейл (пълно сканиране, освен ако зададете височина за възстановяване)."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি একটি সম্পূর্ণ নতুন ওয়ালেট তৈরি করছেন (দ্রুত সিঙ্ক) নাকি একটি বিদ্যমান ওয়ালেট আমদানি করছেন (আপনি একটি রিস্টোর হাইট সেট না করলে সম্পূর্ণ স্ক্যান) তা বেছে নিন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tria si estàs creant una cartera completament nova (sincronització ràpida) o important-ne una existent (escaneig complet, tret que estableixis una alçada de restauració)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte, zda vytváříte úplně novou peněženku (rychlá synchronizace), nebo importujete existující peněženku (úplné skenování, pokud nenastavíte výšku obnovení)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg om du opretter en helt ny tegnebog (hurtig synkronisering) eller importerer en eksisterende tegnebog (fuld scanning, hvis du ikke angiver en gendannelseshøjde)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle, ob du eine brandneue Wallet erstellst (schnelle Synchronisierung) oder eine vorhandene Wallet importierst (vollständiger Scan, sofern du keine Wiederherstellungshöhe festlegst)."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε αν δημιουργείτε ένα ολοκαίνουργιο πορτοφόλι (ταχύς συγχρονισμός) ή εισάγετε ένα υπάρχον πορτοφόλι (πλήρης σάρωση, εκτός αν ορίσετε ύψος επαναφοράς)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose whether you're creating a brand new wallet (fast sync) or importing an existing wallet (full scan unless you set a restore height)."
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Elektu ĉu vi kreas tute novan monujon (rapida sinkronigo) aŭ importas ekzistantan monujon (plena skano, se vi ne agordas restaŭran alton)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige si creas una cartera nueva (sincronización rápida) o importas una existente (escaneo completo salvo que indiques una altura de restauración)."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Valige, kas loote täiesti uue rahakoti (kiire sünkroonimine) või impordite olemasoleva rahakoti (täielik skannimine, kui te ei määra taastamiskõrgust)."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Aukeratu zorro berri bat sortuko duzun (sinkronizazio azkarra) edo lehendik dagoen bat inportatuko duzun (eskaneo osoa, leheneratze-altuera bat ezarri ezean)."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "انتخاب کنید که می‌خواهید یک کیف پول کاملاً جدید بسازید (همگام‌سازی سریع) یا یک کیف پول موجود را وارد کنید (اسکن کامل مگر آن‌که ارتفاع بازیابی تعیین کنید)."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse, luotko täysin uuden lompakon (nopea synkronointi) vai tuotko olemassa olevan lompakon (täysi skannaus, jollet aseta palautuskorkeutta)."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Piliin kung gumagawa ka ng bagong wallet (mabilis na sync) o nag-import ng umiiral na wallet (buong scan maliban kung magtatakda ka ng restore height)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis si tu crées un tout nouveau portefeuille (synchronisation rapide) ou si tu importes un portefeuille existant (analyse complète sauf si tu définis une hauteur de restauration)."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Roghnaigh cé acu an bhfuil tú ag cruthú sparán nua ar fad (sioncronú tapa) nó ag iompórtú sparán atá ann cheana (scanadh iomlán ach amháin má shocraíonn tú airde aisghabhála)."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elixe se estás creando unha carteira totalmente nova (sincronización rápida) ou importando unha existente (escaneo completo salvo que indiques unha altura de restauración)."
          }
        },
        "gn": {
          "stringUnit": {
            "state": "translated",
            "value": "Eiporavo ejapórö peteĩ ñongatuha pyahu (sincronización pya'e) térã eiketa ñongatuha oĩmava (escaneo mbykymby, ejapo'ỹrõ altura de restauración)."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaɓi ko kana ƙirƙirar sabon walat ne (daidaitawa mai sauri) ko kana shigo da walat da ya kasance a baya (cikakken bincike sai dai idan ka saita tsayin dawowa)."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחר אם אתה יוצר ארנק חדש לחלוטין (סנכרון מהיר) או מייבא ארנק קיים (סריקה מלאה אלא אם תגדיר גובה שחזור)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुनें कि क्या आप एक नया वॉलेट बना रहे हैं (फास्ट सिंक) या मौजूदा वॉलेट इम्पोर्ट कर रहे हैं (जब तक आप रिस्टोर हाइट सेट न करें, तब तक पूरा स्कैन होगा)।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberite izrađujete li potpuno novi novčanik (brza sinkronizacija) ili uvozite postojeći novčanik (potpuno skeniranje osim ako ne postavite visinu obnove)."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válaszd ki, hogy egy vadonatúj pénztárcát hozol létre (gyors szinkronizálás), vagy egy meglévő pénztárcát importálsz (teljes átvizsgálás, kivéve, ha megadsz egy visszaállítási magasságot)."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ընտրեք՝ ստեղծում եք բոլորովին նոր դրամապանակ (արագ համաժամացում), թե՞ ներմուծում եք գոյություն ունեցող դրամապանակ (ամբողջական սկանավորում, եթե չսահմանեք վերականգնման բարձրություն)։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih apakah Anda membuat dompet baru (sinkronisasi cepat) atau mengimpor dompet yang sudah ada (pemindaian lengkap kecuali Anda menetapkan tinggi pemulihan)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli se stai creando un wallet completamente nuovo (sincronizzazione rapida) o importando un wallet esistente (scansione completa a meno che non imposti un'altezza di ripristino)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいウォレットを作成する(高速同期)か、既存のウォレットをインポートする(復元高さを設定しない限り全スキャン)かを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완전히 새로운 지갑을 만들지(빠른 동기화), 기존 지갑을 가져올지(복구 높이를 설정하지 않으면 전체 스캔) 선택하세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Жаңыдан капчык жаратып жатканыңызды (тез синхрондоштуруу) же бар болгон капчыкты импорттоп жатканыңызды тандаңыз (калыбына келтирүү бийиктигин койбосоңуз, толук скандоо болот)."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasirinkite, ar kuriate visiškai naują piniginę (greitas sinchronizavimas), ar importuojate esamą piniginę (pilnas skenavimas, jei nenustatysite atkūrimo aukščio)."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Izvēlieties, vai veidojat pilnīgi jaunu maku (ātrā sinhronizācija), vai importējat esošu maku (pilna skenēšana, ja neiestatīsiet atjaunošanas augstumu)."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih sama ada anda mencipta dompet baharu sepenuhnya (penyelarasan pantas) atau mengimport dompet sedia ada (imbasan penuh melainkan anda menetapkan ketinggian pemulihan)."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "သင်သည် ပိုက်ဆံအိတ်အသစ် ဖန်တီးနေခြင်း (မြန်ဆန်သော ထပ်တူညှိမှု) သို့မဟုတ် ရှိပြီးသား ပိုက်ဆံအိတ်ကို ပြန်လည်ရယူနေခြင်း (ပြန်လည်ရယူရန် အမြင့် သတ်မှတ်ခြင်း မရှိလျှင် စကင်ဖတ်မှုအပြည့်) ကို ရွေးချယ်ပါ။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg om du oppretter en helt ny lommebok (rask synkronisering) eller importerer en eksisterende lommebok (full skanning hvis du ikke setter en gjenopprettingshøyde)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies of je een volledig nieuwe wallet aanmaakt (snelle synchronisatie) of een bestaande wallet importeert (volledige scan, tenzij je een hersteldhoogte instelt)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz, czy tworzysz zupełnie nowy portfel (szybka synchronizacja), czy importujesz istniejący portfel (pełne skanowanie, o ile nie ustawisz wysokości przywracania)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha se você está criando uma carteira totalmente nova (sincronização rápida) ou importando uma carteira existente (varredura completa, a menos que você defina uma altura de restauração)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alege dacă creezi un portofel complet nou (sincronizare rapidă) sau imporți un portofel existent (scanare completă, cu excepția cazului în care setezi o înălțime de restaurare)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите, создаёте ли вы совершенно новый кошелёк (быстрая синхронизация) или импортируете существующий (полное сканирование, если не указана высота восстановления)."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte, či vytvárate úplne novú peňaženku (rýchla synchronizácia), alebo importujete existujúcu peňaženku (úplné skenovanie, ak nenastavíte výšku obnovenia)."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izberi, ali ustvarjaš popolnoma novo denarnico (hitra sinhronizacija) ali uvažaš obstoječo denarnico (popolno preiskovanje, razen če določiš višino za obnovitev)."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Zgjidh nëse po krijon një portofol krejt të ri (sinkronizim i shpejtë) ose po importon një portofol ekzistues (skanim i plotë përveç nëse cakton një lartësi rikuperimi)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj om du skapar en helt ny plånbok (snabb synkronisering) eller importerar en befintlig plånbok (fullständig skanning om du inte anger en återställningshöjd)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกว่าคุณกำลังสร้างกระเป๋าเงินใหม่ทั้งหมด (ซิงค์แบบเร็ว) หรือนำเข้ากระเป๋าเงินที่มีอยู่แล้ว (สแกนทั้งหมด เว้นแต่คุณตั้งค่าความสูงการกู้คืน)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yepyeni bir cüzdan mı oluşturduğunuzu (hızlı senkronizasyon) yoksa mevcut bir cüzdanı mı içe aktardığınızı (bir kurtarma yüksekliği belirlemezseniz tam tarama) seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть, чи створюєте ви новий гаманець (швидка синхронізація), чи імпортуєте наявний (повне сканування, якщо не вказано висоту відновлення)."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "منتخب کریں کہ آپ ایک بالکل نیا والٹ بنا رہے ہیں (فاسٹ سنک) یا موجودہ والٹ درآمد کر رہے ہیں (مکمل اسکین، جب تک آپ ریسٹور ہائٹ سیٹ نہ کریں)۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn xem bạn đang tạo một ví hoàn toàn mới (đồng bộ nhanh) hay nhập một ví đã có (quét toàn bộ trừ khi bạn đặt độ cao khôi phục)."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "Yan bóyá o ń ṣẹ̀dá àpamọ́wọ́ tuntun pátápátá (ìṣọ̀kan yára) tàbí o ń gbé àpamọ́wọ́ tí ó ti wà tẹ́lẹ̀ wọlé (yíyẹ̀wò kíkún àyàfi bí o bá ṣètò ipele ìpadàbọ̀)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择创建全新钱包(快速同步)还是导入已有钱包(除非设置恢复高度,否则将进行完整扫描)。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇創建全新錢包(快速同步)還是導入已有錢包(除非設置恢復高度,否則將進行完整掃描)。"
          }
        }
      }
    },
