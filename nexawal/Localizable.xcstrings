          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Bainistigh rochtain nóid, slándáil gléasta, agus iompar aisghabhála."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Xestiona o acceso ao nodo, a seguridade do dispositivo e o comportamento de recuperación."
          }
        },
        "gn": {
          "stringUnit": {
            "state": "translated",
            "value": "Emoĩporã eike hag̃ua nodo-pe, seguridad dispositivo-gua ha mba'éichapa oiko ñemoĩ jey."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Sarrafa samun damar node, tsaron na'ura, da halin dawowa."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Կառավարեք հանգույցի հասանելիությունը, սարքի անվտանգությունը և վերականգնման կարգավորումները։"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Түйүнгө мүмкүнчүлүктү, түзмөк коопсуздугун жана калыбына келтирүү жүрүм-турумун башкарыңыз."
          }
        },
        "sq": {
          "stringUnit": {
