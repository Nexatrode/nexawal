    "Transaction broadcast from selected subaddress via %@.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم بث المعاملة من العنوان الفرعي المحدد عبر %@."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Əməliyyat seçilmiş alt ünvandan %@ vasitəsilə yayımlandı."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Транзакцията от избрания подадрес беше разпратена през %@."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-এর মাধ্যমে নির্বাচিত উপ-ঠিকানা থেকে লেনদেন ব্রডকাস্ট করা হয়েছে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Transacció emesa des de la subadreça seleccionada mitjançant %@."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Transakce z vybrané podadresy byla vyslána přes %@."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaktion udsendt fra valgt underadresse via %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaktion der ausgewählten Unteradresse über %@ übertragen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η συναλλαγή μεταδόθηκε από την επιλεγμένη υποδιεύθυνση μέσω %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaction broadcast from selected subaddress via %@."
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Transakcio elsendita el la elektita subadreso per %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Transacción transmitida desde la subdirección seleccionada vía %@."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tehing edastati valitud alamaadressilt %@ kaudu."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Transakzioa hautatutako azpihelbidetik hedatu da %@ bidez."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تراکنش از زیرآدرس انتخاب‌شده از طریق %@ ارسال شد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapahtuma lähetetty valitusta aliosoitteesta %@:n kautta."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Na-broadcast ang transaksyon mula sa napiling subaddress gamit ang %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaction diffusée depuis la sous-adresse sélectionnée via %@."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Craoladh an idirbheart ón fho-sheoladh roghnaithe trí %@."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transacción difundida desde o subenderezo seleccionado mediante %@."
          }
        },
        "gn": {
          "stringUnit": {
            "state": "translated",
            "value": "Transacción oñemoherakuãma subdirección poravopyre-gui %@ rupive."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "An watsa ma'amala daga sab-adireshin da aka zaɓa ta hanyar %@."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "העסקה שודרה מכתובת המשנה שנבחרה באמצעות %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ के माध्यम से चयनित सब-एड्रेस से ट्रांज़ैक्शन प्रसारित किया गया।"
          }
        },
        "hr": {
