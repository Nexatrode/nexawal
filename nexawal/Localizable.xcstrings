    "Neon terminal look. Leave off for the standard theme (default).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Neon terminal look. Leave off for the standard theme (default)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aspecto de terminal neón. Déjalo desactivado para el tema estándar (predeterminado)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neon-Terminal-Look. Lass diese Option deaktiviert für das Standarddesign (Standard)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apparence terminal néon. Laisse désactivé pour le thème standard (par défaut)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネオンターミナルの見た目です。オフにすると標準テーマ(デフォルト)になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네온 터미널 스타일입니다. 끄면 표준 테마(기본값)가 적용됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Visual de terminal neon. Deixe desativado para o tema padrão (padrão)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Неоновый терминальный вид. Оставьте выключенным для стандартной темы (по умолчанию)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "霓虹终端外观。关闭此项以使用标准主题(默认)。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aspetto terminale neon. Lascia disattivato per il tema standard (predefinito)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Neon-terminaluiterlijk. Laat uit voor het standaardthema (standaard)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampilan terminal neon. Biarkan nonaktif untuk tema standar (default)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Neon terminal görünümü. Standart tema (varsayılan) için kapalı bırak."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नियॉन टर्मिनल लुक। मानक थीम (डिफ़ॉल्ट) के लिए इसे बंद रखें।"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "霓虹終端外觀。關閉此項以使用標準主題(預設)。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wygląd neonowego terminala. Wyłącz, aby użyć standardowego motywu (domyślny)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вигляд неонового терміналу. Вимкніть, щоб використати стандартну тему (за замовчуванням)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giao diện terminal neon. Để tắt để dùng giao diện tiêu chuẩn (mặc định)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปลักษณ์เทอร์มินัลไฟนีออน ปิดไว้เพื่อใช้ธีมมาตรฐาน (ค่าเริ่มต้น)"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ظاهر ترمینال نئونی. برای پوسته استاندارد (پیش‌فرض)، آن را خاموش بگذارید."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vzhled neonového terminálu. Pro standardní motiv (výchozí) jej nechte vypnutý."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Вид на неонов терминал. Оставете изключено за стандартната тема (по подразбиране)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Neonterminalutseende. Lämna av för standardtemat (standard)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aspect neon de tip terminal. Lasă dezactivat pentru tema standard (implicit)."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Neonpreget terminalutseende. La stå av for standardtemaet (standard)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مظهر نيون على شكل طرفية. اتركه معطلاً لاستخدام السمة القياسية (الافتراضية)."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מראה ניאון בסגנון מסוף. השאר כבוי לעיצוב הרגיל (ברירת המחדל)."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "Ìrísí terminal neon. Fi sílẹ̀ tí kò ṣiṣẹ́ fún àwòrán déédé (ìpilẹ̀ṣẹ̀)."
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Neon terminal look. Iwanang naka-off para sa karaniwang tema (default)."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "Neon terminal ပုံစံ။ ပုံမှန် theme (default) အတွက် ပိတ်ထားပါ။"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Rupa terminal neon. Biarkan tidak aktif untuk tema standard (lalai)."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Neon terminal görünüşü. Standart tema üçün (defolt) söndürülmüş saxlayın."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নিয়ন টার্মিনাল লুক। স্ট্যান্ডার্ড থিমের জন্য (ডিফল্ট) বন্ধ রাখুন।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Videz neonskega terminala. Pusti izklopljeno za standardno temo (privzeto)."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Neon terminál kinézet. Hagyd kikapcsolva a standard témához (alapértelmezett)."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Neoninio terminalo išvaizda. Palikite išjungtą standartinei temai (numatytoji)."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Neona termināļa izskats. Atstājiet izslēgtu standarta tēmai (noklusējums)."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نیون ٹرمینل کا انداز۔ معیاری تھیم (ڈیفالٹ) کے لیے اسے بند رکھیں۔"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Neonpäätteen ulkoasu. Jätä pois käytöstä vakioteemaa varten (oletus)."
          }
        }
      }
    },
