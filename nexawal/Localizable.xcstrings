    "Running or connecting to your own Monero node is recommended. Public defaults are for convenience only.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُنصح بتشغيل عقدة Monero الخاصة بك أو الاتصال بها. القيم العامة الافتراضية للراحة فقط."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Öz Monero node-unuzu işə salmaq və ya ona qoşulmaq tövsiyə olunur. İctimai standartlar yalnız rahatlıq üçündür."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Препоръчва се да стартирате или да се свържете към собствен Monero нод. Публичните стойности по подразбиране са само за удобство."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নিজের Monero নোড চালানো বা সংযুক্ত হওয়ার পরামর্শ দেওয়া হয়। পাবলিক ডিফল্ট কেবল সুবিধার জন্য।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Es recomana executar o connectar-vos al vostre propi node de Monero. Els valors públics per defecte són només per comoditat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Doporučuje se provozovat nebo se připojit k vlastnímu Monero nodu. Veřejné výchozí hodnoty jsou pouze pro pohodlí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det anbefales at køre eller oprette forbindelse til din egen Monero-node. Offentlige standardværdier er kun for bekvemmelighed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wird empfohlen, einen eigenen Monero-Node zu betreiben oder sich damit zu verbinden. Öffentliche Standardwerte dienen nur der Bequemlichkeit."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συνιστάται να εκτελείτε ή να συνδέεστε στον δικό σας κόμβο Monero. Οι δημόσιες προεπιλογές είναι μόνο για ευκολία."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Running or connecting to your own Monero node is recommended. Public defaults are for convenience only."
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Oni rekomendas ruli aŭ konekti al via propra Monero-nodo. Publikaj defaŭltoj estas nur por komforto."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se recomienda ejecutar o conectarse a su propio nodo de Monero. Los valores públicos predeterminados son solo por comodidad."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Soovitatav on käivitada või ühenduda oma Monero node’iga. Avalikud vaikeväärtused on ainult mugavuseks."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Gomendagarria da zure Monero nodoa exekutatzea edo konektatzea. Publiko lehenetsiak erosotasunerako soilik dira."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اجرا یا اتصال به نود Monero خودتان توصیه می‌شود. مقادیر پیش‌فرض عمومی فقط برای راحتی هستند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suosittelemme oman Monero-noden käyttämistä tai siihen yhdistämistä. Julkiset oletukset ovat vain mukavuutta varten."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Inirerekomenda ang pagpapatakbo o pagkonekta sa sarili mong Monero node. Ang mga pampublikong default ay para lamang sa kaginhawahan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il est recommandé d’exécuter ou de vous connecter à votre propre nœud Monero. Les valeurs publiques par défaut sont uniquement destinées à la commodité."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Moltar do nód Monero féin a rith nó ceangal leis. Níl na réamhshocruithe poiblí ach ar mhaithe le háisiúlacht."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Recoméndase executar ou conectarse ao seu propio nodo de Monero. Os valores públicos predeterminados son só por comodidade."
          }
        },
        "gn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ojejerure ehechauka térã eike ne nodo Monero-pe. Oĩva público oĩ confortoñguaránte."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana ba da shawarar gudanar da ko haɗawa da naku na Monero. Tsohuwar jama'a don sauƙi ne kawai."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מומלץ להפעיל או להתחבר לצומת Monero משלך. ברירות המחדל הציבוריות נועדו לנוחות בלבד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपना स्वयं का Monero नोड चलाना या उससे कनेक्ट करना अनुशंसित है। सार्वजनिक डिफ़ॉल्ट केवल सुविधा के लिए हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Preporučuje se pokretanje ili povezivanje s vlastitim Monero čvorom. Javne zadane vrijednosti služe samo radi praktičnosti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajánlott saját Monero node futtatása vagy ahhoz csatlakozás. A nyilvános alapértelmezések csak a kényelemért vannak."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Խորհուրդ է տրվում գործարկել կամ միանալ ձեր սեփական Monero հանգույցին։ Հանրային լռելյայնները միայն հարմարության համար են։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Disarankan menjalankan atau terhubung ke node Monero Anda sendiri. Default publik hanya untuk kenyamanan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si raccomanda di eseguire o collegarsi al proprio nodo Monero. I valori pubblici predefiniti sono solo per comodità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "独自の Monero ノードを運用するか接続することを推奨します。公開の既定値は利便性のためのみです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자체 Monero 노드를 실행하거나 연결하는 것을 권장합니다. 공개 기본값은 편의용일 뿐입니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Өз Monero нодуңузду иштетүү же ага туташуу сунушталат. Коомдук демейкилер ыңгайлуулук үчүн гана."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekomenduojama paleisti arba prisijungti prie savo Monero mazgo. Viešosios numatytosios reikšmės skirtos tik patogumui."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ieteicams palaist vai savienoties ar savu Monero mezglu. Publiskās noklusējuma vērtības ir tikai ērtībai."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Disyorkan menjalankan atau menyambung ke nod Monero anda sendiri. Lalai awam hanya untuk kemudahan."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ကိုယ်ပိုင် Monero node ကို ဖွင့်ရန် သို့မဟုတ် ချိတ်ဆက်ရန် အကြံပြုသည်။ အများသုံး မူရင်းတန်ဖိုးများသည် အဆင်ပြေစေရန်သာဖြစ်သည်။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det anbefales å kjøre eller koble til din egen Monero-node. Offentlige standardverdier er kun for bekvemmelighet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het wordt aanbevolen om je eigen Monero-node te draaien of ermee te verbinden. Openbare standaardwaarden zijn alleen voor het gemak."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zalecane jest uruchomienie lub połączenie z własnym węzłem Monero. Publiczne wartości domyślne służą wyłącznie wygodzie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É recomendável executar ou conectar-se ao seu próprio nó Monero. Os padrões públicos são apenas por conveniência."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se recomandă rularea sau conectarea la propriul nod Monero. Valorile publice implicite sunt doar pentru comoditate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рекомендуется запускать или подключаться к собственной ноде Monero. Публичные значения по умолчанию предназначены только для удобства."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odporúča sa prevádzkovať alebo sa pripojiť k vlastnému Monero nodu. Verejné predvolené hodnoty sú len pre pohodlie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Priporočeno je zagnati ali se povezati z lastnim vozliščem Monero. Javne privzete vrednosti so le zaradi udobja."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekomandohet të ekzekutoni ose të lidheni me nyjen tuaj Monero. Vlerat e parazgjedhura publike janë vetëm për lehtësi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det rekommenderas att köra eller ansluta till din egen Monero-nod. Offentliga standardvärden är endast för bekvämlighet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แนะนำให้รันหรือเชื่อมต่อโหนด Monero ของคุณเอง ค่าเริ่มต้นสาธารณะมีไว้เพื่อความสะดวกเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendi Monero düğümünüzü çalıştırmanız veya bağlanmanız önerilir. Genel varsayılanlar yalnızca kolaylık içindir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рекомендується запускати або підключатися до власної ноди Monero. Публічні значення за замовчуванням лише для зручності."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنا Monero نوڈ چلانا یا اس سے جڑنا تجویز کیا جاتا ہے۔ عوامی ڈیفالٹس صرف سہولت کے لیے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nên chạy hoặc kết nối với nút Monero của riêng bạn. Các mặc định công khai chỉ nhằm tiện lợi."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "A dábàá pé kí o ṣiṣẹ́ tàbí so mọ́ node Monero tirẹ. Àwọn àìyípadà gbogbogbòò jẹ́ fún ìrọ̀rùn nìkan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "建议运行或连接您自己的 Monero 节点。公开默认设置仅图方便。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "建議執行或連線至您自己的 Monero 節點。公開預設值僅為方便之用。"
          }
        }
      }
    },
