        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հաշվեկշիռը թարմացվում է, մինչ համաժամացումը հասնում է ընթացիկ վիճակին"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saldo diperbarui selagi sinkronisasi menyusul"
