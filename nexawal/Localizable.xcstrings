            "state": "translated",
            "value": "Transakcija emitirana iz odabrane podadrese putem %@."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tranzakció közvetítve a kiválasztott alcímről a %@ útján."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Գործարքը հեռարձակվեց ընտրված ենթահասցեից %@-ի միջոցով։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaksi disiarkan dari subalamat terpilih melalui %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Transazione trasmessa dal sottoindirizzo selezionato tramite %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 経由で選択したサブアドレスから取引をブロードキャストしました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@를 통해 선택한 서브주소에서 거래가 브로드캐스트되었습니다."
          }
        },
        "ky": {
