    "Manage node access, device security, and recovery behavior.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwalte Node-Zugriff, Gerätesicherheit und Wiederherstellungsverhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manage node access, device security, and recovery behavior."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestiona el acceso al nodo, la seguridad del dispositivo y la recuperación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gère l'accès au nœud, la sécurité de l'appareil et le comportement de récupération."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノードへのアクセス、デバイスセキュリティ、復元動作を管理します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노드 접근, 기기 보안, 복구 동작을 관리하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerencie o acesso ao nó, a segurança do dispositivo e o comportamento de recuperação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Управляйте доступом к узлу, безопасностью устройства и параметрами восстановления."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "管理节点访问、设备安全和恢复行为。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestisci l'accesso al nodo, la sicurezza del dispositivo e il comportamento di ripristino."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beheer node-toegang, apparaatbeveiliging en herstelgedrag."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelola akses node, keamanan perangkat, dan perilaku pemulihan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düğüm erişimini, cihaz güvenliğini ve kurtarma davranışını yönetin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नोड एक्सेस, डिवाइस सुरक्षा और रिकवरी व्यवहार प्रबंधित करें।"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "管理節點訪問、設備安全和恢復行爲。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zarządzaj dostępem do węzła, zabezpieczeniami urządzenia i sposobem odzyskiwania."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Керуйте доступом до вузла, безпекою пристрою та поведінкою відновлення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quản lý quyền truy cập node, bảo mật thiết bị và cách khôi phục."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จัดการการเข้าถึงโหนด ความปลอดภัยของอุปกรณ์ และพฤติกรรมการกู้คืน"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دسترسی به گره، امنیت دستگاه و رفتار بازیابی را مدیریت کنید."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Správa přístupu k uzlu, zabezpečení zařízení a chování obnovení."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Управлявайте достъпа до възела, сигурността на устройството и поведението при възстановяване."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hantera nodåtkomst, enhetssäkerhet och återställningsbeteende."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestionează accesul la nod, securitatea dispozitivului și comportamentul de recuperare."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Administrer nodetilgang, enhetssikkerhet og gjenopprettingsoppførsel."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إدارة الوصول إلى العقدة وأمان الجهاز وسلوك الاستعادة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניהול הגישה לצומת, אבטחת המכשיר והתנהגות השחזור."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "Darí ìwọlé sí node, ààbò ẹ̀rọ, àti ìhùwàsí ìpadàbọ̀."
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pamahalaan ang access sa node, seguridad ng device, at ugali ng recovery."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "Node ဝင်ရောက်ခွင့်၊ စက်ပစ္စည်း လုံခြုံရေးနှင့် ပြန်လည်ရယူမှု အပြုအမူကို စီမံပါ။"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Urus akses node, keselamatan peranti, dan tingkah laku pemulihan."
          }
        },
        "az": {
