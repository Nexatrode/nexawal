          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Saldoa eguneratzen ari da sinkronizazioa amaitu arte"
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Tá an t-iarmhéid ag nuashonrú fad a bhíonn an sioncronú ag teacht chun cinn"
