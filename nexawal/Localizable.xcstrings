    "When enabled, opening the stored wallet and sending funds will require device authentication.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn aktiviert, sind zum Öffnen der gespeicherten Wallet und zum Senden von Geldern eine Geräteauthentifizierung erforderlich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When enabled, opening the stored wallet and sending funds will require device authentication."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si está activado, abrir la cartera guardada y enviar fondos requerirá autenticación del dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois activée, l'ouverture du portefeuille enregistré et l'envoi de fonds nécessiteront une authentification de l'appareil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効にすると、保存されたウォレットを開く際や資金送付時にデバイス認証が必要になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 옵션을 활성화하면 저장된 지갑을 열거나 자금을 전송할 때 기기 인증이 필요합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando ativado, abrir a carteira armazenada e enviar fundos exigirá autenticação do dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если включено, для открытия сохранённого кошелька и отправки средств потребуется аутентификация устройства."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用后,打开已保存的钱包和发送资金都需要进行设备身份验证。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se attivato, l'apertura del wallet memorizzato e l'invio di fondi richiederanno l'autenticazione del dispositivo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Indien ingeschakeld, is apparaatverificatie vereist om de opgeslagen wallet te openen en tegoeden te verzenden."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika diaktifkan, membuka dompet yang tersimpan dan mengirim dana akan memerlukan autentikasi perangkat."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkinleştirildiğinde, kayıtlı cüzdanı açmak ve fon göndermek cihaz kimlik doğrulaması gerektirir."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सक्षम होने पर, संग्रहित वॉलेट खोलने और फंड भेजने के लिए डिवाइस प्रमाणीकरण आवश्यक होगा।"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啓用後,打開已保存的錢包和發送資金都需要進行設備身份驗證。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy włączone, otwieranie zapisanego portfela i wysyłanie środków będzie wymagać uwierzytelnienia urządzenia."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо увімкнено, відкриття збереженого гаманця та надсилання коштів вимагатиме автентифікації пристрою."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi được bật, việc mở ví đã lưu và gửi tiền sẽ yêu cầu xác thực thiết bị."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อเปิดใช้งาน การเปิดกระเป๋าเงินที่จัดเก็บไว้และการส่งเงินจะต้องยืนยันตัวตนอุปกรณ์"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "وقتی فعال باشد، باز کردن کیف پول ذخیره‌شده و ارسال وجوه به احراز هویت دستگاه نیاز خواهد داشت."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když je zapnuto, otevření uložené peněženky a odesílání prostředků bude vyžadovat ověření zařízení."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Когато е включено, отварянето на запазения портфейл и изпращането на средства ще изисква удостоверяване на устройството."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När detta är aktiverat krävs enhetsautentisering för att öppna den sparade plånboken och skicka tillgångar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Când este activată, deschiderea portofelului salvat și trimiterea de fonduri vor necesita autentificarea dispozitivului."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når dette er aktivert, vil åpning av den lagrede lommeboken og sending av midler kreve enhetsautentisering."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند التفعيل، سيتطلب فتح المحفظة المحفوظة وإرسال الأموال مصادقة الجهاز."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כשמופעל, פתיחת הארנק השמור ושליחת כספים ידרשו אימות מכשיר."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "Bí a bá gbé e ṣíṣẹ́, ṣíṣí àpamọ́wọ́ tí a fi pamọ́ àti fífi owó ránṣẹ́ yóò nílò ìmúdájú ẹ̀rọ."
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kung pinagana, mangangailangan ng device authentication ang pagbukas ng nakaimbak na wallet at pagpadala ng pondo."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ဖွင့်ထားပါက၊ သိမ်းဆည်းထားသော ပိုက်ဆံအိတ်ကို ဖွင့်ခြင်းနှင့် ငွေပို့ခြင်းအတွက် စက်ပစ္စည်း အထောက်အထားစိစစ်မှု လိုအပ်မည်။"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika didayakan, membuka dompet yang disimpan dan menghantar wang akan memerlukan pengesahan peranti."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiv edildikdə, saxlanılan pulqabını açmaq və vəsait göndərmək üçün cihaz autentifikasiyası tələb olunacaq."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "চালু করা হলে, সংরক্ষিত ওয়ালেট খোলা এবং ফান্ড পাঠাতে ডিভাইস প্রমাণীকরণ প্রয়োজন হবে।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ko je omogočeno, bo za odpiranje shranjene denarnice in pošiljanje sredstev potrebno preverjanje naprave."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha bekapcsolod, a tárolt pénztárca megnyitásához és a küldéshez eszközhitelesítés szükséges."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kai įjungta, saugomos piniginės atidarymui ir lėšų siuntimui reikės įrenginio tapatybės patvirtinimo."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad iespējots, saglabātā maka atvēršanai un līdzekļu sūtīšanai būs nepieciešama ierīces autentifikācija."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فعال ہونے پر، محفوظ والٹ کھولنے اور فنڈز بھیجنے کے لیے ڈیوائس تصدیق درکار ہو گی۔"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun käytössä, tallennetun lompakon avaaminen ja varojen lähettäminen vaatii laitteen todennuksen."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Quan estigui activat, obrir la cartera desada i enviar fons requerirà autenticació del dispositiu."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kada je omogućeno, otvaranje spremljenog novčanika i slanje sredstava zahtijevat će autentifikaciju uređaja."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Keď je zapnuté, otvorenie uloženej peňaženky a odosielanie prostriedkov bude vyžadovať overenie zariadenia."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når dette er aktiveret, kræver det enhedsgodkendelse at åbne den gemte tegnebog og sende midler."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν είναι ενεργοποιημένο, το άνοιγμα του αποθηκευμένου πορτοφολιού και η αποστολή κεφαλαίων θα απαιτούν έλεγχο ταυτότητας συσκευής."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui see on lubatud, nõuab salvestatud rahakoti avamine ja vahendite saatmine seadme autentimist."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktibatuta dagoenean, gordetako zorroa irekitzeko eta funtsak bidaltzeko gailuaren autentifikazioa beharko da."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuair a bheidh sé cumasaithe, éileoidh oscailt an sparáin stóráilte agus seoladh cistí fíordheimhniú gléasta."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cando está activada, abrir a carteira gardada e enviar fondos requirirá autenticación do dispositivo."
          }
        },
        "gn": {
          "stringUnit": {
            "state": "translated",
            "value": "Oñemyendýrõ, eipe'a hag̃ua ñongatuha ñeñongatupyre ha emondo hag̃ua viru, tekotevẽta autenticación dispositivo-gua."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Idan an kunna, buɗe walat da ajiye da aika kuɗaɗe za su buƙaci tantancewar na'ura."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Երբ միացված է, պահված դրամապանակը բացելը և միջոցներ ուղարկելը կպահանջեն սարքի նույնականացում։"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Иштетилгенде, сакталган капчыкты ачуу жана каражат жөнөтүү түзмөк аутентификациясын талап кылат."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Kur aktivizohet, hapja e portofolit të ruajtur dhe dërgimi i fondeve do të kërkojnë autentikim të pajisjes."
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiam ebligita, malfermo de la konservita monujo kaj sendo de fonduso postulos aparat-aŭtentigon."
          }
        }
      }
    },
