    "Controls how many Monero accounts are scanned starting at account 0.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestimmt, wie viele Monero-Konten ab Konto 0 gescannt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Controls how many Monero accounts are scanned starting at account 0."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Controla cuántas cuentas Monero se escanean desde la cuenta 0."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définit le nombre de comptes Monero analysés à partir du compte 0."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウント0から開始してスキャンするMoneroアカウントの数を制御します。"
