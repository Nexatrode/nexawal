        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমি ব্যবহারের শর্তাবলী পড়েছি এবং সম্মত"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "He llegit i accepto les Condicions d'ús"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přečetl(a) jsem si Podmínky použití a souhlasím s nimi"
