        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda boleh menggunakan Face ID untuk melindungi dompet anda."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulqabınızı qorumaq üçün Face ID istifadə edə bilərsiniz."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি আপনার ওয়ালেট সুরক্ষিত করতে Face ID ব্যবহার করতে পারেন।"
