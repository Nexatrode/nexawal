    "Manage node access, device security, and recovery behavior." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إدارة الوصول إلى العقدة وأمان الجهاز وسلوك الاستعادة."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Node girişini, cihaz təhlükəsizliyini və bərpa davranışını idarə edin."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Управлявайте достъпа до възела, сигурността на устройството и поведението при възстановяване."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নোড অ্যাক্সেস, ডিভাইস সিকিউরিটি এবং পুনরুদ্ধার আচরণ পরিচালনা করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gestiona l'accés al node, la seguretat del dispositiu i el comportament de recuperació."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Správa přístupu k uzlu, zabezpečení zařízení a chování obnovení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Administrer nodeadgang, enhedssikkerhed og gendannelsesadfærd."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwalte Node-Zugriff, Gerätesicherheit und Wiederherstellungsverhalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διαχειριστείτε την πρόσβαση κόμβου, την ασφάλεια της συσκευής και τη συμπεριφορά ανάκτησης."
