    "When enabled, opening the stored wallet and sending funds will require device authentication." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند التفعيل، سيتطلب فتح المحفظة المحفوظة وإرسال الأموال مصادقة الجهاز."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiv edildikdə, saxlanılan pulqabını açmaq və vəsait göndərmək üçün cihaz autentifikasiyası tələb olunacaq."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когато е включено, отварянето на запазения портфейл и изпращането на средства ще изисква удостоверяване на устройството."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "চালু করা হলে, সংরক্ষিত ওয়ালেট খোলা এবং ফান্ড পাঠাতে ডিভাইস প্রমাণীকরণ প্রয়োজন হবে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quan estigui activat, obrir la cartera desada i enviar fons requerirà autenticació del dispositiu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když je zapnuto, otevření uložené peněženky a odesílání prostředků bude vyžadovat ověření zařízení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når dette er aktiveret, kræver det enhedsgodkendelse at åbne den gemte tegnebog og sende midler."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aktiviert, sind zum Öffnen der gespeicherten Wallet und zum Senden von Geldern eine Geräteauthentifizierung erforderlich."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν είναι ενεργοποιημένο, το άνοιγμα του αποθηκευμένου πορτοφολιού και η αποστολή κεφαλαίων θα απαιτούν έλεγχο ταυτότητας συσκευής."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled, opening the stored wallet and sending funds will require device authentication."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiam ebligita, malfermo de la konservita monujo kaj sendo de fonduso postulos aparat-aŭtentigon."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está activado, abrir la cartera guardada y enviar fondos requerirá autenticación del dispositivo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kui see on lubatud, nõuab salvestatud rahakoti avamine ja vahendite saatmine seadme autentimist."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktibatuta dagoenean, gordetako zorroa irekitzeko eta funtsak bidaltzeko gailuaren autentifikazioa beharko da."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وقتی فعال باشد، باز کردن کیف پول ذخیره‌شده و ارسال وجوه به احراز هویت دستگاه نیاز خواهد داشت."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun käytössä, tallennetun lompakon avaaminen ja varojen lähettäminen vaatii laitteen todennuksen."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kung pinagana, mangangailangan ng device authentication ang pagbukas ng nakaimbak na wallet at pagpadala ng pondo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une fois activée, l'ouverture du portefeuille enregistré et l'envoi de fonds nécessiteront une authentification de l'appareil."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuair a bheidh sé cumasaithe, éileoidh oscailt an sparáin stóráilte agus seoladh cistí fíordheimhniú gléasta."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cando está activada, abrir a carteira gardada e enviar fondos requirirá autenticación do dispositivo."
          }
        },
        "gn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oñemyendýrõ, eipe'a hag̃ua ñongatuha ñeñongatupyre ha emondo hag̃ua viru, tekotevẽta autenticación dispositivo-gua."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Idan an kunna, buɗe walat da ajiye da aika kuɗaɗe za su buƙaci tantancewar na'ura."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כשמופעל, פתיחת הארנק השמור ושליחת כספים ידרשו אימות מכשיר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सक्षम होने पर, संग्रहित वॉलेट खोलने और फंड भेजने के लिए डिवाइस प्रमाणीकरण आवश्यक होगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kada je omogućeno, otvaranje spremljenog novčanika i slanje sredstava zahtijevat će autentifikaciju uređaja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha bekapcsolod, a tárolt pénztárca megnyitásához és a küldéshez eszközhitelesítés szükséges."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Երբ միացված է, պահված դրամապանակը բացելը և միջոցներ ուղարկելը կպահանջեն սարքի նույնականացում։"
