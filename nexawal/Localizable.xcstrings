          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Frais estimés (entrées limitées à la sous-adresse sélectionnée)."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Táille measta (ionchuir teoranta don fho-sheoladh roghnaithe)."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
