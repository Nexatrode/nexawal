    "Show the QR code, copy the address, or create a fresh receive address for better privacy.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeige den QR-Code, kopiere die Adresse oder erstelle eine neue Empfangsadresse für mehr Privatsphäre."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show the QR code, copy the address, or create a fresh receive address for better privacy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra el código QR, copia la dirección o crea una nueva dirección de recepción para más privacidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche le code QR, copie l'adresse ou crée une nouvelle adresse de réception pour plus de confidentialité."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "QRコードを表示したり、アドレスをコピーしたり、より高いプライバシーのために新しい受取用アドレスを作成したりできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "QR 코드를 표시하거나 주소를 복사하거나, 더 나은 개인정보 보호를 위해 새 수신 주소를 만드세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostre o código QR, copie o endereço ou crie um novo endereço de recebimento para mais privacidade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Покажите QR-код, скопируйте адрес или создайте новый адрес получения для лучшей приватности."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示 QR 码、复制地址,或创建新的接收地址以获得更好的隐私保护。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra il codice QR, copia l'indirizzo o crea un nuovo indirizzo di ricezione per una maggiore privacy."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toon de QR-code, kopieer het adres, of maak een nieuw ontvangstadres aan voor meer privacy."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampilkan kode QR, salin alamat, atau buat alamat terima baru untuk privasi yang lebih baik."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "QR kodunu gösterin, adresi kopyalayın veya daha iyi gizlilik için yeni bir alım adresi oluşturun."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "QR कोड दिखाएं, पता कॉपी करें, या बेहतर प्राइवेसी के लिए एक नया प्राप्तकर्ता पता बनाएं।"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示 QR 碼、複製地址,或創建新的接收地址以獲得更好的隱私保護。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokaż kod QR, skopiuj adres lub utwórz nowy adres odbiorczy dla większej prywatności."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Покажіть QR-код, скопіюйте адресу або створіть нову адресу отримання для більшої конфіденційності."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện mã QR, sao chép địa chỉ hoặc tạo địa chỉ nhận mới để bảo mật tốt hơn."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงโค้ด QR คัดลอกที่อยู่ หรือสร้างที่อยู่รับเงินใหม่เพื่อความเป็นส่วนตัวที่ดีขึ้น"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کد QR را نمایش دهید، آدرس را کپی کنید یا برای حریم خصوصی بهتر یک آدرس دریافت جدید بسازید."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazte QR kód, zkopírujte adresu nebo pro lepší soukromí vytvořte novou přijímací adresu."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Покажете QR кода, копирайте адреса или създайте нов адрес за получаване за по-добра поверителност."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visa QR-koden, kopiera adressen eller skapa en ny mottagaradress för bättre integritet."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Afișează codul QR, copiază adresa sau creează o adresă de primire nouă pentru o confidențialitate mai bună."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis QR-koden, kopier adressen, eller opprett en ny mottaksadresse for bedre personvern."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أظهر رمز QR، أو انسخ العنوان، أو أنشئ عنوان استقبال جديدًا لخصوصية أفضل."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הצג את קוד ה-QR, העתק את הכתובת, או צור כתובת קבלה חדשה לפרטיות טובה יותר."
          }
        }
      }
    },
