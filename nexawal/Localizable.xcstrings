    "You can use Face ID to secure your wallet.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst Face ID verwenden, um deine Wallet zu schützen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can use Face ID to secure your wallet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes usar Face ID para proteger tu cartera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu peux utiliser Face ID pour protéger ton portefeuille."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Face IDでウォレットを保護できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID를 사용하여 지갑을 보호할 수 있습니다."
          }
