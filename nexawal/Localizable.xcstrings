          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নোড অ্যাক্সেস, ডিভাইস সিকিউরিটি এবং পুনরুদ্ধার আচরণ পরিচালনা করুন।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Upravljaj dostop do vozlišča, varnost naprave in obnašanje pri obnovitvi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kezeld a csomópont-hozzáférést, az eszközbiztonságot és a helyreállítási viselkedést."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvarkykite tinklo taško prieigą, įrenginio saugumą ir atkūrimo elgseną."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pārvaldiet mezgla piekļuvi, ierīces drošību un atjaunošanas darbību."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نوڈ تک رسائی، ڈیوائس سیکیورٹی، اور ریکوری رویے کا انتظام کریں۔"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hallitse solmun käyttöoikeutta, laitteen tietoturvaa ja palautustoimintaa."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestiona l'accés al node, la seguretat del dispositiu i el comportament de recuperació."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Upravljajte pristupom čvoru, sigurnošću uređaja i ponašanjem oporavka."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Správa prístupu k uzlu, zabezpečenia zariadenia a správania obnovenia."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Administrer nodeadgang, enhedssikkerhed og gendannelsesadfærd."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διαχειριστείτε την πρόσβαση κόμβου, την ασφάλεια της συσκευής και τη συμπεριφορά ανάκτησης."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
