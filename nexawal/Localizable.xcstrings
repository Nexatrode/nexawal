    "Mnemonic cannot be empty.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Mnemonic darf nicht leer sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mnemonic cannot be empty."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La frase mnemónica no puede estar vacía."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La phrase mnémonique ne peut pas être vide."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ニーモニックを空にすることはできません。"
          }
        },
