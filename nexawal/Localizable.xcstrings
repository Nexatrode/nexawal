            "value": "A(s) palavra(s) ainda não coincide(m)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuvântul (sau cuvintele) nu se potrivesc încă."
          }
        },
        "ru": {
