          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Word(s) don't match yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las palabras aún no coinciden."
          }
        },
        "fr": {
