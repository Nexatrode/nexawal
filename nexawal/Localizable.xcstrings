    "Only change scan lookahead if an import appears incomplete after using the right restore height.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only change scan lookahead if an import appears incomplete after using the right restore height."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia el alcance de escaneo solo si una importación parece incompleta tras usar la altura correcta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Altere a antecipação de varredura somente se uma importação parecer incompleta após usar a altura de restauração correta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅当使用正确的恢复高度后导入仍显示不完整时,才更改扫描预扫数。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменяйте глубину сканирования только если импорт выглядит неполным после использования правильной высоты восстановления."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändere den Scan-Lookahead nur, wenn ein Import nach Verwendung der richtigen Wiederherstellungshöhe unvollständig erscheint."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne modifie l'avance d'analyse que si l'importation semble incomplète après avoir utilisé la bonne hauteur de restauration."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "正しい復元高さを使用した後もインポートが不完全に見える場合にのみ、スキャンの先読み数を変更してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "올바른 복구 높이를 사용한 후에도 가져오기가 불완전해 보일 때만 스캔 선행 조회 값을 변경하세요."
          }
        }
      }
    },
    "Only change these values if a wallet import appears incomplete after using the correct restore height.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only change these values if a wallet import appears incomplete after using the correct restore height."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia estos valores solo si la importación parece incompleta tras usar la altura de restauración correcta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Altere estes valores somente se a importação de uma carteira parecer incompleta após usar a altura de restauração correta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅当使用正确的恢复高度后钱包导入仍显示不完整时,才更改这些值。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменяйте эти значения только если импорт кошелька выглядит неполным после использования правильной высоты восстановления."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändere diese Werte nur, wenn ein Wallet-Import nach Verwendung der richtigen Wiederherstellungshöhe unvollständig erscheint."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne modifie ces valeurs que si l'importation du portefeuille semble incomplète après avoir utilisé la bonne hauteur de restauration."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "正しい復元高さを使用した後もウォレットのインポートが不完全に見える場合にのみ、これらの値を変更してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "올바른 복구 높이를 사용한 후에도 지갑 가져오기가 불완전해 보일 때만 이 값들을 변경하세요."
          }
        }
      }
    },
