    "Transaction broadcast from selected subaddress via %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaktion der ausgewählten Unteradresse über %@ übertragen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaction broadcast from selected subaddress via %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Transacción transmitida desde la subdirección seleccionada vía %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaction diffusée depuis la sous-adresse sélectionnée via %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 経由で選択したサブアドレスから取引をブロードキャストしました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@를 통해 선택한 서브주소에서 거래가 브로드캐스트되었습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Transação transmitida do subendereço selecionado via %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Транзакция от выбранного подадреса отправлена в сеть через %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已通过 %@ 从所选子地址广播交易。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Transazione trasmessa dal sottoindirizzo selezionato tramite %@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transactie uitgezonden vanaf geselecteerd subadres via %@."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaksi disiarkan dari subalamat terpilih melalui %@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşlem, seçili alt adresten %@ üzerinden yayınlandı."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ के माध्यम से चयनित सब-एड्रेस से ट्रांज़ैक्शन प्रसारित किया गया।"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已通過 %@ 從所選子地址廣播交易。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transakcja wysłana z wybranego podadresu przez %@."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Транзакцію транслювано з вибраної підадреси через %@."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã phát giao dịch từ địa chỉ phụ đã chọn qua %@."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กระจายธุรกรรมจากที่อยู่ย่อยที่เลือกผ่าน %@ แล้ว"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تراکنش از زیرآدرس انتخاب‌شده از طریق %@ ارسال شد."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Transakce z vybrané podadresy byla vyslána přes %@."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Транзакцията от избрания подадрес беше разпратена през %@."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaktion sänd från vald underadress via %@."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tranzacție difuzată din subadresa selectată prin %@."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaksjon kringkastet fra valgt underadresse via %@."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم بث المعاملة من العنوان الفرعي المحدد عبر %@."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "העסקה שודרה מכתובת המשנה שנבחרה באמצעות %@."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "A ti tan ìṣòwò jáde láti sub-àdírẹ́sì tí a yàn nípasẹ̀ %@."
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na-broadcast ang transaksyon mula sa napiling subaddress gamit ang %@."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ရွေးချယ်ထားသော subaddress မှ ငွေပေးငွေယူမှုကို %@ ဖြင့် ပျံ့နှံ့စေပြီးပါပြီ။"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaksi disiarkan daripada sub-alamat terpilih melalui %@."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Əməliyyat seçilmiş alt ünvandan %@ vasitəsilə yayımlandı."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-এর মাধ্যমে নির্বাচিত উপ-ঠিকানা থেকে লেনদেন ব্রডকাস্ট করা হয়েছে।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transakcija oddana z izbranega podnaslova prek %@."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tranzakció közvetítve a kiválasztott alcímről a %@ útján."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Operacija transliuota iš pasirinkto subadreso per %@."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Transakcija pārraidīta no izvēlētās subadreses, izmantojot %@."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "منتخب سب ایڈریس سے ٹرانزیکشن %@ کے ذریعے براڈکاسٹ ہو گئی۔"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapahtuma lähetetty valitusta aliosoitteesta %@:n kautta."
          }
        }
      }
    },
