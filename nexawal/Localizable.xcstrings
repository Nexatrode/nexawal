    "Wallet must be unlocked before changing biometric protection.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Wallet muss entsperrt sein, bevor der biometrische Schutz geändert werden kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wallet must be unlocked before changing biometric protection."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Debes desbloquear la cartera antes de cambiar la protección biométrica."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le portefeuille doit être déverrouillé avant de modifier la protection biométrique."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "生体認証保護を変更する前にウォレットのロックを解除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "생체 인증 보호를 변경하려면 먼저 지갑 잠금을 해제해야 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A carteira precisa estar desbloqueada antes de alterar a proteção biométrica."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед изменением биометрической защиты кошелёк должен быть разблокирован."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改生物识别保护设置前须先解锁钱包。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il wallet deve essere sbloccato prima di modificare la protezione biometrica."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wallet moet ontgrendeld zijn voordat je de biometrische beveiliging wijzigt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dompet harus dibuka kuncinya sebelum mengubah proteksi biometrik."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Biyometrik korumayı değiştirmeden önce cüzdanın kilidi açılmalıdır."
