        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συνιστάται να εκτελείτε ή να συνδέεστε στον δικό σας κόμβο Monero. Οι δημόσιες προεπιλογές είναι μόνο για ευκολία."
          }
        },
        "eo": {
