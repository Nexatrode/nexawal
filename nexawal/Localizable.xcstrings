          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ရွေးချယ်ထားသော subaddress မှ ငွေပေးငွေယူမှုကို %@ ဖြင့် ပျံ့နှံ့စေပြီးပါပြီ။"
          }
        },
        "nb": {
