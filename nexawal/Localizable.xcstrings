        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gestiona el acceso al nodo, la seguridad del dispositivo y la recuperación."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
