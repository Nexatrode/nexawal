        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se sincronizează portofelul"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Synkroniserer lommebok"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جارٍ مزامنة المحفظة"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מסנכרן את הארנק"
          }
        }
      }
    },
    "Tap Refresh Wallet to continue (or reopen the app).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf „Wallet aktualisieren“, um fortzufahren (oder starte die App neu)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Refresh Wallet to continue (or reopen the app)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca Actualizar cartera para continuar (o vuelve a abrir la app)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuie sur « Actualiser le portefeuille » pour continuer (ou rouvre l'application)."
