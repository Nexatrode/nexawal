          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Avgift uppskattad (indata begränsad till vald underadress)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Comision estimat (intrări limitate la subadresa selectată)."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Avgift estimert (input begrenset til valgt underadresse)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تقدير الرسوم (المدخلات مقيّدة بالعنوان الفرعي المحدد)."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "העמלה שוערה (התשומות מוגבלות לכתובת המשנה שנבחרה)."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "A ti ṣírò ọya (àwọn ìwọlé ni a dá sí sub-àdírẹ́sì tí a yàn)."
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinantya ang bayad (limitado ang input sa napiling subaddress)."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "အခကြေးငွေ ခန့်မှန်းပြီး (input များသည် ရွေးချယ်ထားသော subaddress အတွင်း ကန့်သတ်ထားသည်)။"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Yuran dianggarkan (input dihadkan kepada sub-alamat terpilih)."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Komissiya qiymətləndirildi (girişlər seçilmiş alt ünvanla məhdudlaşdırılıb)."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফি অনুমান করা হয়েছে (ইনপুট নির্বাচিত উপ-ঠিকানায় সীমাবদ্ধ)।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Provizija ocenjena (vhodi omejeni na izbrani podnaslov)."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Díj becsülve (a bemenetek a kiválasztott alcímre korlátozva)."
