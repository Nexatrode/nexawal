            "value": "Stanje se ažurira dok sinkronizacija ne dostigne mrežu"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az egyenleg frissül, amíg a szinkronizálás felzárkózik"
