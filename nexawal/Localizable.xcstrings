          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этом устройстве уже сохранён кошелёк."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备上已存有一个钱包。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un wallet è già memorizzato su questo dispositivo."
          }
        },
        "nl": {
