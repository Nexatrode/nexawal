          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šiame įrenginyje jau saugoma piniginė."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šajā ierīcē jau ir saglabāts maks."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس ڈیوائس پر پہلے ہی ایک والٹ محفوظ ہے۔"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tähän laitteeseen on jo tallennettu lompakko."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja hi ha una cartera desada en aquest dispositiu."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Novčanik je već spremljen na ovom uređaju."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "V tomto zariadení je už uložená peňaženka."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er allerede gemt en tegnebog på denne enhed."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Υπάρχει ήδη αποθηκευμένο πορτοφόλι σε αυτή τη συσκευή."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Selles seadmes on juba rahakott salvestatud."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Gailu honetan zorro bat gordeta dago jada."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Tá sparán stóráilte ar an ghléas seo cheana."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Xa hai unha carteira gardada neste dispositivo."
          }
        },
        "gn": {
          "stringUnit": {
            "state": "translated",
            "value": "Peteĩ ñongatuha oĩma ñeñongatupyre ko dispositivo-pe."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "An riga an ajiye walat a wannan na'urar."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս սարքում արդեն պահված է դրամապանակ։"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул түзмөктө капчык мурунтан сакталган."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Një portofol është ruajtur tashmë në këtë pajisje."
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Monujo estas jam konservita sur ĉi tiu aparato."
          }
        }
      }
    },
