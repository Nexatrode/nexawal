    "Type the full URL, including http:// or https://.\nPublic: https://rpc.nexatrode.com\nLAN: http://192.168.4.137:18089": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type the full URL, including http:// or https://.\nPublic: https://rpc.nexatrode.com\nLAN: http://192.168.4.137:18089"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe la URL completa, incluyendo http:// o https://.\nPública: https://rpc.nexatrode.com\nLAN: http://192.168.4.137:18089"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite a URL completa, incluindo http:// ou https://.\nPública: https://rpc.nexatrode.com\nLAN: http://192.168.4.137:18089"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入完整网址,包括 http:// 或 https://。\n公共节点:https://rpc.nexatrode.com\n局域网:http://192.168.4.137:18089"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите полный URL, включая http:// или https://.\nПубличный: https://rpc.nexatrode.com\nЛокальный: http://192.168.4.137:18089"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib die vollständige URL ein, einschließlich http:// oder https://.\nÖffentlich: https://rpc.nexatrode.com\nLAN: http://192.168.4.137:18089"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
