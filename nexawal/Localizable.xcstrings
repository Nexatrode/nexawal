        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जारी रखने के लिए वॉलेट रिफ्रेश करें पर टैप करें (या ऐप को फिर से खोलें)।"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點擊“刷新錢包”以繼續(或重新打開應用)。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotknij Odśwież portfel, aby kontynuować (lub otwórz aplikację ponownie)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть Оновити гаманець, щоб продовжити (або перезапустіть застосунок)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn Làm mới ví để tiếp tục (hoặc mở lại ứng dụng)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะรีเฟรชกระเป๋าเงินเพื่อดำเนินการต่อ (หรือเปิดแอปใหม่)"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای ادامه، روی «به‌روزرسانی کیف پول» ضربه بزنید (یا برنامه را دوباره باز کنید)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokračujte klepnutím na Obnovit peněženku (nebo znovu otevřete aplikaci)."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Докоснете „Обновяване на портфейла“, за да продължите (или отворете отново приложението)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på Uppdatera plånbok för att fortsätta (eller öppna appen igen)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apasă Reîmprospătează portofelul pentru a continua (sau redeschide aplicația)."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk Oppdater lommebok for å fortsette (eller åpne appen på nytt)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على تحديث المحفظة للاستمرار (أو أعد فتح التطبيق)."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקש על רענון הארנק כדי להמשיך (או פתח מחדש את האפליקציה)."
          }
        }
      }
    },
    "This is your recovery seed. Write it down on paper and store it somewhere safe. Anyone with these words can access your funds — nexawal never uploads or backs it up for you.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist dein Wiederherstellungs-Seed. Schreibe ihn auf Papier auf und bewahre ihn an einem sicheren Ort auf. Jeder, der diese Wörter kennt, kann auf dein Guthaben zugreifen — nexawal lädt ihn niemals hoch oder sichert ihn für dich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is your recovery seed. Write it down on paper and store it somewhere safe. Anyone with these words can access your funds — nexawal never uploads or backs it up for you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta es tu frase de recuperación. Anótala en papel y guárdala en un lugar seguro. Cualquiera con estas palabras puede acceder a tus fondos — nexawal nunca la sube ni la respalda por ti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voici ta phrase de récupération (seed). Note-la sur papier et conserve-la en lieu sûr. Toute personne connaissant ces mots peut accéder à tes fonds — nexawal ne la télécharge ni ne la sauvegarde jamais pour toi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これはあなたの復元シードです。紙に書き留めて安全な場所に保管してください。これらの単語を知っている人は誰でもあなたの資金にアクセスできます — nexawalはシードをアップロードしたり、代わりにバックアップしたりすることは一切ありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이것은 복구 시드입니다. 종이에 적어 안전한 곳에 보관하세요. 이 단어들을 아는 사람은 누구나 자금에 접근할 수 있습니다 — nexawal은 이를 절대 업로드하거나 대신 백업하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta é a sua semente de recuperação. Anote-a no papel e guarde-a em um lugar seguro. Qualquer pessoa com essas palavras pode acessar seus fundos — o nexawal nunca faz upload ou backup dela para você."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это ваша сид-фраза для восстановления. Запишите её на бумаге и храните в надёжном месте. Любой, кто узнает эти слова, сможет получить доступ к вашим средствам — nexawal никогда не загружает и не создаёт резервную копию за вас."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是您的恢复种子。请将它写在纸上并存放在安全的地方。任何持有这些词的人都可以动用您的资金 — nexawal 不会为您上传或备份它。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo è il tuo seed di recupero. Scrivilo su carta e conservalo in un luogo sicuro. Chiunque possieda queste parole può accedere ai tuoi fondi — nexawal non lo carica né ne esegue mai il backup per te."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is je herstelseed. Schrijf het op papier en bewaar het op een veilige plek. Iedereen met deze woorden heeft toegang tot je tegoeden — nexawal uploadt of maakt hier nooit een back-up van voor jou."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini adalah seed pemulihan Anda. Tuliskan di atas kertas dan simpan di tempat yang aman. Siapa pun yang memiliki kata-kata ini dapat mengakses dana Anda — nexawal tidak pernah mengunggah atau membuat cadangannya untuk Anda."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sizin kurtarma tohumunuzdur. Onu kağıda yazın ve güvenli bir yerde saklayın. Bu kelimelere sahip olan herkes fonlarınıza erişebilir — nexawal onu sizin için asla yüklemez veya yedeklemez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह आपकी रिकवरी सीड है। इसे कागज़ पर लिखें और किसी सुरक्षित जगह रखें। इन शब्दों को जानने वाला कोई भी व्यक्ति आपके फंड एक्सेस कर सकता है — nexawal इसे कभी अपलोड या आपके लिए बैकअप नहीं करता।"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是您的恢復種子。請將它寫在紙上並存放在安全的地方。任何持有這些詞的人都可以動用您的資金 — nexawal 不會爲您上傳或備份它。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To jest Twoja fraza odzyskiwania. Zapisz ją na papierze i przechowuj w bezpiecznym miejscu. Każdy, kto zna te słowa, może uzyskać dostęp do Twoich środków — nexawal nigdy nie wysyła jej ani nie tworzy dla Ciebie kopii zapasowej."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це ваша фраза відновлення. Запишіть її на папері та зберігайте в безпечному місці. Будь-хто, хто знає ці слова, може отримати доступ до ваших коштів — nexawal ніколи не завантажує її й не створює резервну копію за вас."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đây là cụm từ khôi phục của bạn. Hãy ghi lại trên giấy và lưu giữ ở nơi an toàn. Bất kỳ ai có các từ này đều có thể truy cập tiền của bạn — nexawal không bao giờ tải lên hoặc sao lưu nó cho bạn."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นี่คือวลีกู้คืนของคุณ จดลงบนกระดาษและเก็บไว้ในที่ปลอดภัย ใครก็ตามที่รู้คำเหล่านี้สามารถเข้าถึงเงินของคุณได้ — nexawal จะไม่อัปโหลดหรือสำรองข้อมูลนี้ให้คุณเด็ดขาด"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این عبارت بازیابی شماست. آن را روی کاغذ بنویسید و در جای امنی نگه دارید. هر کسی که این کلمات را داشته باشد می‌تواند به وجوه شما دسترسی پیدا کند — nexawal هرگز آن را بارگذاری یا برای شما پشتیبان‌گیری نمی‌کند."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto je vaše fráze pro obnovení. Zapište si ji na papír a uložte na bezpečném místě. Kdokoli, kdo tato slova zná, se může dostat k vašim prostředkům — nexawal ji nikdy nikam nenahrává ani ji za vás nezálohuje."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Това е вашата фраза за възстановяване. Запишете я на хартия и я съхранявайте на безопасно място. Всеки, който притежава тези думи, може да достъпи средствата ви — nexawal никога не я качва онлайн и не я архивира за вас."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta är din återställningsfras. Skriv den ner på papper och förvara den på ett säkert ställe. Vem som helst med dessa ord kan komma åt dina tillgångar — nexawal laddar aldrig upp den eller säkerhetskopierar den åt dig."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceasta este cheia ta de recuperare. Notează-o pe hârtie și păstreaz-o într-un loc sigur. Oricine deține aceste cuvinte poate accesa fondurile tale — nexawal nu le încarcă și nu le salvează niciodată pentru tine."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette er gjenopprettingsfrasen din. Skriv den ned på papir og oppbevar den et trygt sted. Alle som har disse ordene kan få tilgang til midlene dine — nexawal laster aldri opp eller sikkerhetskopierer den for deg."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه عبارة الاستعادة الخاصة بك. اكتبها على ورقة واحفظها في مكان آمن. يمكن لأي شخص يملك هذه الكلمات الوصول إلى أموالك — لا يقوم nexawal مطلقًا برفعها أو نسخها احتياطيًا نيابة عنك."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זהו ביטוי השחזור שלך. כתוב אותו על ניר ושמור אותו במקום בטוח. כל מי שמחזיק במילים אלה יכול לגשת לכספים שלך — nexawal לעולם לא מעלה או מגבה אותו בשבילך."
          }
        }
      }
    },
    "This resets scan state and starts over from the height you enter.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird der Scan-Status zurückgesetzt und ab der eingegebenen Höhe neu gestartet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This resets scan state and starts over from the height you enter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto reinicia el estado de escaneo y empieza desde la altura que indiques."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela réinitialise l'état d'analyse et redémarre depuis la hauteur que tu indiques."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これによりスキャン状態がリセットされ、入力した高さから再開されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이렇게 하면 스캔 상태가 재설정되고 입력한 높이부터 다시 시작됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso redefine o estado de varredura e começa novamente a partir da altura que você informar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это сбросит состояние сканирования и начнёт заново с указанной вами высоты."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将重置扫描状态,并从您输入的高度重新开始。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo azzera lo stato di scansione e ricomincia dall'altezza che inserisci."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit reset de scanstatus en begint opnieuw vanaf de hoogte die je invoert."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini akan mengatur ulang status pemindaian dan mulai dari awal dari tinggi yang Anda masukkan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, tarama durumunu sıfırlar ve girdiğiniz yükseklikten yeniden başlar."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इससे स्कैन स्थिति रीसेट हो जाती है और आपके द्वारा दर्ज की गई हाइट से फिर से शुरू होता है।"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這將重置掃描狀態,並從您輸入的高度重新開始。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To resetuje stan skanowania i zaczyna od nowa od podanej wysokości."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це скидає стан сканування та починає заново з введеної вами висоти."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc này sẽ đặt lại trạng thái quét và bắt đầu lại từ độ cao bạn nhập."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การทำเช่นนี้จะรีเซ็ตสถานะการสแกนและเริ่มต้นใหม่จากความสูงที่คุณกรอก"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این کار وضعیت اسکن را بازنشانی می‌کند و از ارتفاعی که وارد می‌کنید، دوباره شروع می‌کند."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tímto se resetuje stav skenování a začne se znovu od výšky, kterou zadáte."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Това нулира състоянието на сканиране и започва отново от височината, която въведете."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta återställer skanningstillståndet och börjar om från den höjd du anger."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această acțiune resetează starea de scanare și o reia de la înălțimea introdusă."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette nullstiller skanntilstanden og starter på nytt fra høyden du oppgir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يؤدي هذا إلى إعادة ضبط حالة المسح والبدء من جديد من الارتفاع الذي تدخله."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פעולה זו מאפסת את מצב הסריקה ומתחילה מחדש מהגובה שתזין."
          }
        }
      }
    },
    "This will replace the existing wallet on this device.\n\nIf you continue, the currently stored mnemonic and scan state will be removed. Make sure you have your mnemonic backed up before proceeding.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird die vorhandene Wallet auf diesem Gerät ersetzt.\n\nWenn du fortfährst, werden der derzeit gespeicherte Mnemonic und der Scan-Status entfernt. Stelle sicher, dass du ein Backup deines Mnemonics hast, bevor du fortfährst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will replace the existing wallet on this device.\n\nIf you continue, the currently stored mnemonic and scan state will be removed. Make sure you have your mnemonic backed up before proceeding."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto reemplazará la cartera existente en este dispositivo.\n\nSi continúas, se eliminarán la frase mnemónica y el estado de escaneo guardados. Asegúrate de tener tu frase respaldada antes de continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela remplacera le portefeuille existant sur cet appareil.\n\nSi tu continues, la phrase mnémonique enregistrée et l'état d'analyse seront supprimés. Assure-toi d'avoir sauvegardé ta phrase mnémonique avant de continuer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これによりこのデバイス上の既存のウォレットが置き換えられます。\n\n続行すると、保存されているニーモニックとスキャン状態が削除されます。続行する前に必ずニーモニックをバックアップしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기의 기존 지갑을 교체합니다.\n\n계속하면 현재 저장된 니모닉과 스캔 상태가 삭제됩니다. 진행하기 전에 니모닉을 백업했는지 확인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso substituirá a carteira existente neste dispositivo.\n\nSe você continuar, o mnemônico armazenado atualmente e o estado de varredura serão removidos. Certifique-se de ter feito backup do seu mnemônico antes de continuar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это заменит существующий кошелёк на этом устройстве.\n\nЕсли вы продолжите, сохранённая мнемоническая фраза и состояние сканирования будут удалены. Убедитесь, что у вас есть резервная копия мнемонической фразы, перед тем как продолжить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将替换此设备上的现有钱包。\n\n如果继续,当前存储的助记词和扫描状态将被删除。请确保在继续之前已备份好您的助记词。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo sostituirà il wallet esistente su questo dispositivo.\n\nSe continui, la mnemonica attualmente memorizzata e lo stato di scansione verranno rimossi. Assicurati di aver fatto il backup della tua mnemonica prima di procedere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit vervangt de bestaande wallet op dit apparaat.\n\nAls je doorgaat, worden de huidige opgeslagen mnemonic en scanstatus verwijderd. Zorg ervoor dat je een back-up van je mnemonic hebt voordat je doorgaat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini akan mengganti dompet yang sudah ada di perangkat ini.\n\nJika Anda melanjutkan, mnemonic dan status pemindaian yang tersimpan saat ini akan dihapus. Pastikan Anda telah mencadangkan mnemonic Anda sebelum melanjutkan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, bu cihazdaki mevcut cüzdanın yerini alacaktır.\n\nDevam ederseniz, şu anda kayıtlı olan anımsatıcı ve tarama durumu kaldırılacaktır. Devam etmeden önce anımsatıcınızı yedeklediğinizden emin olun."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह इस डिवाइस पर मौजूदा वॉलेट को बदल देगा।\n\nयदि आप जारी रखते हैं, तो वर्तमान में संग्रहित म्नेमोनिक और स्कैन स्थिति हटा दी जाएगी। आगे बढ़ने से पहले सुनिश्चित करें कि आपके पास अपने म्नेमोनिक का बैकअप है।"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這將替換此設備上的現有錢包。\n\n如果繼續,當前存儲的助記詞和掃描狀態將被刪除。請確保在繼續之前已備份好您的助記詞。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To zastąpi istniejący portfel na tym urządzeniu.\n\nJeśli będziesz kontynuować, aktualnie zapisana fraza mnemoniczna i stan skanowania zostaną usunięte. Zanim przejdziesz dalej, upewnij się, że masz zapisaną kopię swojej frazy mnemonicznej."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це замінить наявний гаманець на цьому пристрої.\n\nЯкщо ви продовжите, поточну збережену мнемонічну фразу та стан сканування буде видалено. Перш ніж продовжити, переконайтеся, що маєте резервну копію мнемонічної фрази."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc này sẽ thay thế ví hiện có trên thiết bị này.\n\nNếu bạn tiếp tục, cụm từ mnemonic và trạng thái quét đang lưu sẽ bị xóa. Hãy đảm bảo bạn đã sao lưu cụm từ mnemonic trước khi tiếp tục."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การทำเช่นนี้จะแทนที่กระเป๋าเงินที่มีอยู่บนอุปกรณ์นี้\n\nหากคุณดำเนินการต่อ วลีช่วยจำและสถานะการสแกนที่จัดเก็บไว้ในปัจจุบันจะถูกลบออก โปรดตรวจสอบให้แน่ใจว่าคุณได้สำรองวลีช่วยจำไว้แล้วก่อนดำเนินการต่อ"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این کار کیف پول موجود روی این دستگاه را جایگزین می‌کند.\n\nاگر ادامه دهید، عبارت بازیابی و وضعیت اسکن ذخیره‌شده کنونی حذف خواهند شد. پیش از ادامه، مطمئن شوید که از عبارت بازیابی خود پشتیبان گرفته‌اید."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tímto se nahradí existující peněženka v tomto zařízení.\n\nBudete-li pokračovat, aktuálně uložená mnemonická fráze a stav skenování budou odstraněny. Než budete pokračovat, ujistěte se, že máte mnemonickou frázi zálohovanou."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Това ще замени съществуващия портфейл на това устройство.\n\nАко продължите, текущо запазената мнемонична фраза и състоянието на сканиране ще бъдат премахнати. Уверете се, че имате резервно копие на мнемоничната фраза, преди да продължите."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta kommer att ersätta den befintliga plånboken på den här enheten.\n\nOm du fortsätter tas den nu sparade mnemoniska frasen och skanningstillståndet bort. Se till att du har säkerhetskopierat din mnemoniska fras innan du fortsätter."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această acțiune va înlocui portofelul existent pe acest dispozitiv.\n\nDacă continui, mnemonicul salvat și starea de scanare vor fi eliminate. Asigură-te că ai o copie de siguranță a mnemonicului înainte de a continua."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette vil erstatte den eksisterende lommeboken på denne enheten.\n\nHvis du fortsetter, blir den lagrede mnemonicen og skanntilstanden fjernet. Sørg for at du har sikkerhetskopiert mnemonicen før du fortsetter."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي ذلك إلى استبدال المحفظة الموجودة على هذا الجهاز.\n\nإذا استمررت، ستُحذف العبارة التذكيرية المحفوظة وحالة المسح الحاليتان. تأكد من أنك قد نسخت العبارة التذكيرية احتياطيًا قبل الاستمرار."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פעולה זו תחליף את הארנק הקיים במכשיר זה.\n\nאם תמשיך, המנמוניקה השמורה ומצב הסריקה יימחקו. הקפד שיש לך גיבוי של המנמוניקה לפני שתמשיך."
          }
        }
      }
    },
