    "Running or connecting to your own Monero node is recommended. Public defaults are for convenience only.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Running or connecting to your own Monero node is recommended. Public defaults are for convenience only."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُنصح بتشغيل عقدة Monero الخاصة بك أو الاتصال بها. القيم العامة الافتراضية للراحة فقط."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Öz Monero node-unuzu işə salmaq və ya ona qoşulmaq tövsiyə olunur. İctimai standartlar yalnız rahatlıq üçündür."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Препоръчва се да стартирате или да се свържете към собствен Monero нод. Публичните стойности по подразбиране са само за удобство."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নিজের Monero নোড চালানো বা সংযুক্ত হওয়ার পরামর্শ দেওয়া হয়। পাবলিক ডিফল্ট কেবল সুবিধার জন্য।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Es recomana executar o connectar-vos al vostre propi node de Monero. Els valors públics per defecte són només per comoditat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Doporučuje se provozovat nebo se připojit k vlastnímu Monero nodu. Veřejné výchozí hodnoty jsou pouze pro pohodlí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det anbefales at køre eller oprette forbindelse til din egen Monero-node. Offentlige standardværdier er kun for bekvemmelighed."
