          "stringUnit": {
            "state": "translated",
            "value": "Het wordt aanbevolen om je eigen Monero-node te draaien of ermee te verbinden. Openbare standaardwaarden zijn alleen voor het gemak."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zalecane jest uruchomienie lub połączenie z własnym węzłem Monero. Publiczne wartości domyślne służą wyłącznie wygodzie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É recomendável executar ou conectar-se ao seu próprio nó Monero. Os padrões públicos são apenas por conveniência."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se recomandă rularea sau conectarea la propriul nod Monero. Valorile publice implicite sunt doar pentru comoditate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рекомендуется запускать или подключаться к собственной ноде Monero. Публичные значения по умолчанию предназначены только для удобства."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odporúča sa prevádzkovať alebo sa pripojiť k vlastnému Monero nodu. Verejné predvolené hodnoty sú len pre pohodlie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Priporočeno je zagnati ali se povezati z lastnim vozliščem Monero. Javne privzete vrednosti so le zaradi udobja."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekomandohet të ekzekutoni ose të lidheni me nyjen tuaj Monero. Vlerat e parazgjedhura publike janë vetëm për lehtësi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det rekommenderas att köra eller ansluta till din egen Monero-nod. Offentliga standardvärden är endast för bekvämlighet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แนะนำให้รันหรือเชื่อมต่อโหนด Monero ของคุณเอง ค่าเริ่มต้นสาธารณะมีไว้เพื่อความสะดวกเท่านั้น"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Inirerekomenda ang pagpapatakbo o pagkonekta sa sarili mong Monero node. Ang mga pampublikong default ay para lamang sa kaginhawahan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendi Monero düğümünüzü çalıştırmanız veya bağlanmanız önerilir. Genel varsayılanlar yalnızca kolaylık içindir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рекомендується запускати або підключатися до власної ноди Monero. Публічні значення за замовчуванням лише для зручності."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنا Monero نوڈ چلانا یا اس سے جڑنا تجویز کیا جاتا ہے۔ عوامی ڈیفالٹس صرف سہولت کے لیے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nên chạy hoặc kết nối với nút Monero của riêng bạn. Các mặc định công khai chỉ nhằm tiện lợi."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "A dábàá pé kí o ṣiṣẹ́ tàbí so mọ́ node Monero tirẹ. Àwọn àìyípadà gbogbogbòò jẹ́ fún ìrọ̀rùn nìkan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "建议运行或连接您自己的 Monero 节点。公开默认设置仅图方便。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "建議執行或連線至您自己的 Monero 節點。公開預設值僅為方便之用。"
          }
        }
      }
