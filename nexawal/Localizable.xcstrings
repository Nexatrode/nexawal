            "value": "ဆက်လက်ရန် ပိုက်ဆံအိတ် ပြန်လည်စတင်မည် ကို နှိပ်ပါ (သို့) app ကို ပြန်ဖွင့်ပါ။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk Oppdater lommebok for å fortsette (eller åpne appen på nytt)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op Wallet Vernieuwen om door te gaan (of open de app opnieuw)."
          }
        },
        "pl": {
