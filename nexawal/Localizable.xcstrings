          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось получить быструю высоту восстановления от узла. Высота восстановления оставлена равной 0."
          }
        },
        "zh-Hans": {
          "stringUnit": {
