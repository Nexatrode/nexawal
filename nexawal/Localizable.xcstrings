        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Nõuanne: 0 skannib kogu ahela ajaloo. See on kõige ohutum valik, kui te ei ole kindel, kuid sünkroonimine võib kauem aega võtta."
          }
        },
        "eu": {
