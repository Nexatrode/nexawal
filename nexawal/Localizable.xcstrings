    "A new receive address (subaddress) will be generated for privacy.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم إنشاء عنوان استقبال جديد (عنوان فرعي) لمزيد من الخصوصية."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Məxfilik üçün yeni qəbul ünvanı (alt ünvan) yaradılacaq."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "За по-добра поверителност ще бъде генериран нов адрес за получаване (подадрес)."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রাইভেসির জন্য একটি নতুন রিসিভ ঠিকানা (উপ-ঠিকানা) তৈরি করা হবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Es generarà una nova adreça de recepció (subadreça) per a més privadesa."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Z důvodu ochrany soukromí bude vygenerována nová přijímací adresa (podadresa)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der genereres en ny modtagelsesadresse (underadresse) for privatlivets skyld."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für mehr Privatsphäre wird eine neue Empfangsadresse (Unteradresse) erstellt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θα δημιουργηθεί μια νέα διεύθυνση λήψης (υποδιεύθυνση) για λόγους απορρήτου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A new receive address (subaddress) will be generated for privacy."
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Nova ricevada adreso (subadreso) estos generita por privateco."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se generará una nueva dirección de recepción (subdirección) por privacidad."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
