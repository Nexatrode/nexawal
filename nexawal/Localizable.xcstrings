            "value": "Er is al een wallet opgeslagen op dit apparaat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebuah dompet sudah tersimpan di perangkat ini."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazda zaten kayıtlı bir cüzdan var."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस पर एक वॉलेट पहले से संग्रहित है।"
          }
        },
        "zh-Hant": {
