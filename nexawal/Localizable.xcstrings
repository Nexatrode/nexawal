          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Controla quantas contas Monero são varridas a partir da conta 0."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Определяет, сколько аккаунтов Monero сканируется, начиная с аккаунта 0."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "控制从账户 0 开始扫描的 Monero 账户数量。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla quanti account Monero vengono scansionati a partire dall'account 0."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bepaalt hoeveel Monero-accounts worden gescand, vanaf account 0."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengatur berapa banyak akun Monero yang dipindai mulai dari akun 0."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "0. hesaptan başlayarak kaç Monero hesabının taranacağını denetler."
          }
        }
      }
    },
