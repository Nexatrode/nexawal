    "Controls how many Monero accounts are scanned starting at account 0.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestimmt, wie viele Monero-Konten ab Konto 0 gescannt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Controls how many Monero accounts are scanned starting at account 0."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Controla cuántas cuentas Monero se escanean desde la cuenta 0."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définit le nombre de comptes Monero analysés à partir du compte 0."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウント0から開始してスキャンするMoneroアカウントの数を制御します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정 0부터 스캔할 Monero 계정 수를 제어합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Controla quantas contas Monero são varridas a partir da conta 0."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Определяет, сколько аккаунтов Monero сканируется, начиная с аккаунта 0."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "控制从账户 0 开始扫描的 Monero 账户数量。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla quanti account Monero vengono scansionati a partire dall'account 0."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bepaalt hoeveel Monero-accounts worden gescand, vanaf account 0."
