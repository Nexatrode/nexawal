    "I have read and agree to the Terms of Use": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد قرأت وأوافق على شروط الاستخدام"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İstifadə Şərtlərini oxudum və razıyam"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Прочетох и се съгласявам с Условията за ползване"
