    "Fee estimated (inputs constrained to selected subaddress).": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تقدير الرسوم (المدخلات مقيّدة بالعنوان الفرعي المحدد)."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Komissiya qiymətləndirildi (girişlər seçilmiş alt ünvanla məhdudlaşdırılıb)."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Таксата е оценена (входовете са ограничени до избрания подадрес)."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফি অনুমান করা হয়েছে (ইনপুট নির্বাচিত উপ-ঠিকানায় সীমাবদ্ধ)।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Comissió estimada (entrades limitades a la subadreça seleccionada)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Poplatek odhadnut (vstupy omezeny na vybranou podadresu)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebyr estimeret (input begrænset til valgt underadresse)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebühr geschätzt (Eingaben auf die ausgewählte Unteradresse beschränkt)."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η προμήθεια εκτιμήθηκε (οι είσοδοι περιορίζονται στην επιλεγμένη υποδιεύθυνση)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fee estimated (inputs constrained to selected subaddress)."
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Krompago taksita (enigoj limigitaj al la elektita subadreso)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comisión estimada (entradas limitadas a la subdirección seleccionada)."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasu hinnatud (sisendid piiratud valitud alamaadressiga)."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Komisioa kalkulatuta (sarrerak hautatutako azpihelbidera mugatuta)."
