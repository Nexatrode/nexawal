    "Confirm you wrote it down: enter the requested words below.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestätige, dass du dir die Wörter aufgeschrieben hast: Gib unten die angeforderten Wörter ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm you wrote it down: enter the requested words below."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirma que la anotaste: escribe las palabras pedidas abajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirme que tu l'as notée : saisis les mots demandés ci-dessous."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き留めたことを確認してください:以下に指定された単語を入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "받아 적으셨는지 확인합니다: 아래에 요청된 단어를 입력하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirme que você anotou: digite as palavras solicitadas abaixo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подтвердите, что вы её записали: введите запрошенные слова ниже."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认您已写下种子:请在下方输入所要求的词。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conferma di averlo annotato: inserisci qui sotto le parole richieste."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevestig dat je het hebt opgeschreven: voer de gevraagde woorden hieronder in."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfirmasi bahwa Anda telah menulisnya: masukkan kata-kata yang diminta di bawah ini."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yazdığınızı onaylayın: aşağıda istenen kelimeleri girin."
          }
        }
      }
    },
