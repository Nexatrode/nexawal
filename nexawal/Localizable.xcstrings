          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beseda(-e) se še ne ujemajo."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjala(ët) nuk përputhet(en) ende."
          }
        },
        "sv": {
          "stringUnit": {
