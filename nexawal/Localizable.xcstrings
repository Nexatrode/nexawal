    "Couldn't fetch a fast restore height from the node. Leaving restore height as 0.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es konnte keine schnelle Wiederherstellungshöhe vom Node abgerufen werden. Die Wiederherstellungshöhe bleibt bei 0."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't fetch a fast restore height from the node. Leaving restore height as 0."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo obtener una altura de restauración rápida del nodo. Se deja la altura en 0."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de récupérer une hauteur de restauration rapide depuis le nœud. La hauteur de restauration reste à 0."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノードから高速復元高さを取得できませんでした。復元高さは0のままにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노드에서 빠른 복구 높이를 가져올 수 없습니다. 복구 높이를 0으로 둡니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível obter uma altura de restauração rápida do nó. A altura de restauração permanecerá em 0."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось получить быструю высоту восстановления от узла. Высота восстановления оставлена равной 0."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法从节点获取快速恢复高度,恢复高度将保持为 0。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile recuperare un'altezza di ripristino rapida dal nodo. L'altezza di ripristino resta a 0."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kon geen snelle hersteldhoogte ophalen bij de node. Hersteldhoogte blijft op 0."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat mengambil tinggi pemulihan cepat dari node. Tinggi pemulihan dibiarkan pada 0."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düğümden hızlı bir kurtarma yüksekliği alınamadı. Kurtarma yüksekliği 0 olarak bırakılıyor."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नोड से फास्ट रिस्टोर हाइट प्राप्त नहीं हो सकी। रिस्टोर हाइट को 0 पर छोड़ा जा रहा है।"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
