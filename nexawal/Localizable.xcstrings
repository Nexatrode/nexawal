    "Balance updating while sync catches up": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Guthaben wird aktualisiert, während die Synchronisierung aufholt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Balance updating while sync catches up"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El saldo se actualiza mientras termina la sincronización"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le solde se met à jour pendant la synchronisation"
          }
        },
        "ja": {
