    "Enter the recipient and amount, preview the fee, then confirm the transaction.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib Empfänger und Betrag ein, sieh dir die Gebühr an und bestätige dann die Transaktion."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the recipient and amount, preview the fee, then confirm the transaction."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce el destinatario y la cantidad, previsualiza la comisión y confirma la transacción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisis le destinataire et le montant, vérifie les frais, puis confirme la transaction."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送金先と金額を入力し、手数料を確認してから取引を確定してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "받는 사람과 금액을 입력하고 수수료를 미리 확인한 다음 거래를 확인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite o destinatário e o valor, visualize a taxa e, depois, confirme a transação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите получателя и сумму, просмотрите комиссию, затем подтвердите транзакцию."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入收款人和金额,预览手续费,然后确认交易。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci il destinatario e l'importo, visualizza l'anteprima della commissione, poi conferma la transazione."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer de ontvanger en het bedrag in, bekijk de vergoeding en bevestig daarna de transactie."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan penerima dan jumlah, pratinjau biaya, lalu konfirmasi transaksi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alıcıyı ve miktarı girin, ücreti önizleyin, ardından işlemi onaylayın."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्राप्तकर्ता और राशि दर्ज करें, फ़ीस का पूर्वावलोकन करें, फिर ट्रांज़ैक्शन की पुष्टि करें।"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入收款人和金額,預覽手續費,然後確認交易。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wprowadź odbiorcę i kwotę, sprawdź opłatę, a następnie potwierdź transakcję."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть отримувача і суму, перегляньте комісію, а потім підтвердьте транзакцію."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập người nhận và số tiền, xem trước phí, sau đó xác nhận giao dịch."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กรอกผู้รับและจำนวนเงิน ดูตัวอย่างค่าธรรมเนียม แล้วยืนยันธุรกรรม"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "گیرنده و مقدار را وارد کنید، کارمزد را پیش‌نمایش کنید، سپس تراکنش را تأیید کنید."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadejte příjemce a částku, zobrazte náhled poplatku a poté potvrďte transakci."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Въведете получателя и сумата, прегледайте таксата, след което потвърдете транзакцията."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ange mottagare och belopp, förhandsgranska avgiften och bekräfta sedan transaktionen."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Introdu destinatarul și suma, previzualizează comisionul, apoi confirmă tranzacția."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Angi mottaker og beløp, forhåndsvis avgiften, og bekreft deretter transaksjonen."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل المستلم والمبلغ، عاين الرسوم، ثم أكّد المعاملة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הזן את הנמען והסכום, הצג תצוגה מקדימה של העמלה, ולאחר מכן אשר את העסקה."
          }
        }
      }
    },
