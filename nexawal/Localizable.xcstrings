          "stringUnit" : {
            "state" : "translated",
            "value" : "Алуучуну жана сумманы киргизиңиз, комиссияны алдын ала көрүңүз, андан кийин транзакцияны ырастаңыз."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Įveskite gavėją ir sumą, peržiūrėkite mokestį, tada patvirtinkite operaciją."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ievadiet saņēmēju un summu, apskatiet maksu un tad apstipriniet transakciju."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masukkan penerima dan jumlah, pratonton yuran, kemudian sahkan transaksi."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "လက်ခံသူနှင့် ပမာဏကို ထည့်ပါ၊ အခကြေးငွေကို အစမ်းကြည့်ပါ၊ ထို့နောက် ငွေပေးငွေယူမှုကို အတည်ပြုပါ။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angi mottaker og beløp, forhåndsvis avgiften, og bekreft deretter transaksjonen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voer de ontvanger en het bedrag in, bekijk de vergoeding en bevestig daarna de transactie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wprowadź odbiorcę i kwotę, sprawdź opłatę, a następnie potwierdź transakcję."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digite o destinatário e o valor, visualize a taxa e, depois, confirme a transação."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introdu destinatarul și suma, previzualizează comisionul, apoi confirmă tranzacția."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Введите получателя и сумму, просмотрите комиссию, затем подтвердите транзакцию."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zadajte príjemcu a sumu, zobrazte náhľad poplatku a potom potvrďte transakciu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vnesi prejemnika in znesek, si oglej predogled provizije, nato potrdi transakcijo."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fut marrësin dhe shumën, shiko paraprakisht tarifën, pastaj konfirmo transaksionin."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ange mottagare och belopp, förhandsgranska avgiften och bekräfta sedan transaktionen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กรอกผู้รับและจำนวนเงิน ดูตัวอย่างค่าธรรมเนียม แล้วยืนยันธุรกรรม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alıcıyı ve miktarı girin, ücreti önizleyin, ardından işlemi onaylayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Введіть отримувача і суму, перегляньте комісію, а потім підтвердьте транзакцію."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وصول کنندہ اور رقم درج کریں، فیس کا پیش منظر دیکھیں، پھر ٹرانزیکشن کی تصدیق کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhập người nhận và số tiền, xem trước phí, sau đó xác nhận giao dịch."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kọ ẹni tí yóò gbà àti iye, wo ọya ṣáájú, kí o sì fọwọ́sí ìṣòwò náà."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "输入收款人和金额,预览手续费,然后确认交易。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "輸入收款人和金額,預覽手續費,然後確認交易。"
          }
        }
      }
