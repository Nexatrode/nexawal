    "A new receive address (subaddress) will be generated for privacy.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für mehr Privatsphäre wird eine neue Empfangsadresse (Unteradresse) erstellt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A new receive address (subaddress) will be generated for privacy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se generará una nueva dirección de recepción (subdirección) por privacidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une nouvelle adresse de réception (sous-adresse) sera générée pour préserver la confidentialité."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プライバシー保護のため、新しい受取用アドレス(サブアドレス)が生成されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개인정보 보호를 위해 새 수신 주소(서브주소)가 생성됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um novo endereço de recebimento (subendereço) será gerado para maior privacidade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для повышения приватности будет создан новый адрес получения (подадрес)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为了保护隐私,将生成一个新的接收地址(子地址)。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrà generato un nuovo indirizzo di ricezione (sottoindirizzo) per la privacy."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er wordt een nieuw ontvangstadres (subadres) gegenereerd voor privacy."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Alamat terima baru (subalamat) akan dibuat untuk privasi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gizlilik için yeni bir alım adresi (alt adres) oluşturulacak."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गोपनीयता के लिए एक नया प्राप्तकर्ता पता (सब-एड्रेस) जनरेट किया जाएगा।"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "爲了保護隱私,將生成一個新的接收地址(子地址)。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zostanie wygenerowany nowy adres odbiorczy (podadres) w celu zachowania prywatności."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для конфіденційності буде згенеровано нову адресу отримання (підадресу)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một địa chỉ nhận mới (địa chỉ phụ) sẽ được tạo để bảo mật quyền riêng tư."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จะมีการสร้างที่อยู่รับเงินใหม่ (ที่อยู่ย่อย) เพื่อความเป็นส่วนตัว"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای حفظ حریم خصوصی، یک آدرس دریافت جدید (زیرآدرس) ایجاد خواهد شد."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Z důvodu ochrany soukromí bude vygenerována nová přijímací adresa (podadresa)."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "За по-добра поверителност ще бъде генериран нов адрес за получаване (подадрес)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En ny mottagaradress (underadress) skapas för ökad integritet."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Va fi generată o adresă de primire nouă (subadresă) pentru confidențialitate."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En ny mottaksadresse (underadresse) vil bli generert for personvern."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم إنشاء عنوان استقبال جديد (عنوان فرعي) لمزيد من الخصوصية."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כתובת קבלה חדשה (כתובת משנה) תיווצר לשם פרטיות."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "A óò ṣẹ̀dá àdírẹ́sì gbígbà tuntun (sub-àdírẹ́sì) fún àṣírí."
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bubuo ng bagong address ng pagtanggap (subaddress) para sa privacy."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ကိုယ်ရေးလုံခြုံမှုအတွက် လက်ခံရန် လိပ်စာအသစ် (subaddress) ကို ထုတ်ပေးမည်။"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Alamat penerimaan baharu (sub-alamat) akan dijana untuk privasi."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Məxfilik üçün yeni qəbul ünvanı (alt ünvan) yaradılacaq."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রাইভেসির জন্য একটি নতুন রিসিভ ঠিকানা (উপ-ঠিকানা) তৈরি করা হবে।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za zasebnost bo ustvarjen nov naslov za prejem (podnaslov)."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy új fogadó cím (alcím) jön létre az adatvédelem érdekében."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Privatumo tikslais bus sugeneruotas naujas gavimo adresas (subadresas)."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Privātuma nolūkos tiks izveidota jauna saņemšanas adrese (subadrese)."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "رازداری کے لیے ایک نیا وصولی ایڈریس (سب ایڈریس) بنایا جائے گا۔"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yksityisyyden vuoksi luodaan uusi vastaanotto-osoite (aliosoite)."
          }
        }
      }
    },
    "A send is already in progress. Wait for it to finish.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Sendetransaktion läuft bereits. Bitte warte, bis sie abgeschlossen ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A send is already in progress. Wait for it to finish."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya hay un envío en curso. Espera a que termine."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un envoi est déjà en cours. Attends qu'il se termine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送金処理が既に進行中です。完了までお待ちください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 전송이 진행 중입니다. 완료될 때까지 기다려 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um envio já está em andamento. Aguarde a conclusão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправка уже выполняется. Подождите её завершения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已有一笔发送正在进行,请等待其完成。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un invio è già in corso. Attendi che finisca."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is al een verzending bezig. Wacht tot deze is voltooid."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengiriman sedang berlangsung. Tunggu hingga selesai."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaten devam eden bir gönderim var. Tamamlanmasını bekleyin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक भेजना पहले से जारी है। इसके पूरा होने की प्रतीक्षा करें।"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已有一筆發送正在進行,請等待其完成。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wysyłka jest już w toku. Poczekaj na jej zakończenie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надсилання вже виконується. Зачекайте, доки воно завершиться."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang có một giao dịch gửi đang xử lý. Vui lòng chờ đến khi hoàn tất."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีการส่งเงินที่กำลังดำเนินการอยู่ กรุณารอให้เสร็จสิ้นก่อน"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ارسالی در حال انجام است. صبر کنید تا تکمیل شود."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odeslání již probíhá. Vyčkejte na jeho dokončení."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Вече има изпращане в процес. Изчакайте да приключи."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En sändning pågår redan. Vänta tills den är klar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O trimitere este deja în curs. Așteaptă să se finalizeze."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En sending er allerede i gang. Vent til den er ferdig."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عملية إرسال قيد التنفيذ بالفعل. انتظر حتى تنتهي."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שליחה כבר בתהליך. חכה שתסתיים."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "Fífiránṣẹ́ kan ń lọ lọ́wọ́ báyìí. Dúró kí ó parí."
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "May kasalukuyang isinasagawang pagpadala. Hintayin itong matapos."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ပို့ခြင်းတစ်ခု လုပ်ဆောင်နေပြီးပါပြီ။ ပြီးဆုံးအောင် စောင့်ပါ။"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Penghantaran sedang berjalan. Tunggu sehingga selesai."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Göndərmə artıq davam edir. Bitməsini gözləyin."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি পাঠানো প্রক্রিয়া ইতিমধ্যে চলছে। এটি শেষ হওয়ার জন্য অপেক্ষা করুন।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pošiljanje je že v teku. Počakaj, da se konča."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Már folyamatban van egy küldés. Várd meg, amíg befejeződik."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Siuntimas jau vyksta. Palaukite, kol jis baigsis."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sūtīšana jau notiek. Nogaidiet, līdz tā pabeidzas."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک ترسیل پہلے ہی جاری ہے۔ اس کے مکمل ہونے کا انتظار کریں۔"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lähetys on jo käynnissä. Odota, että se päättyy."
          }
        }
      }
    },
