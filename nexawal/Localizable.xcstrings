        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "O saldo actualízase mentres a sincronización se pon ao día"
          }
        },
        "gn": {
          "stringUnit": {
            "state": "translated",
            "value": "Saldo oñembopyahuhína sincronización oñembopa mboyve"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana sabunta ma'auni yayin da daidaitawa take kama gurbi"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հաշվեկշիռը թարմացվում է, մինչ համաժամացումը հասնում է ընթացիկ վիճակին"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхрондоштуруу жетишип жатканда баланс жаңыртылат"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
