            "value": "خواندن متادیتای کیف پول ذخیره‌شده ناموفق بود"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepodařilo se přečíst uložená metadata peněženky"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Прочитането на запазените метаданни на портфейла не бе успешно"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det gick inte att läsa sparad plånboksmetadata"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Citirea metadatelor portofelului salvat a eșuat"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke lese lagrede lommebok-metadata"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشلت قراءة البيانات الوصفية المحفوظة للمحفظة"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קריאת המטא-דאטה השמורה של הארנק נכשלה"
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "A kò lè ka ìròyìn àpamọ́wọ́ tí a fi pamọ́"
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nabigong basahin ang nakaimbak na metadata ng wallet"
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "သိမ်းဆည်းထားသော ပိုက်ဆံအိတ် metadata ကို ဖတ်၍ မရပါ"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gagal membaca metadata dompet tersimpan"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Saxlanılan pulqabı metadatası oxuna bilmədi"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সংরক্ষিত ওয়ালেট মেটাডেটা পড়া যায়নি"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Branje shranjenih metapodatkov denarnice ni uspelo"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem sikerült beolvasni a tárolt pénztárca metaadatait"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepavyko nuskaityti saugomos piniginės metaduomenų"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Neizdevās nolasīt saglabātā maka metadatus"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "محفوظ والٹ میٹا ڈیٹا پڑھنا ناکام ہوا"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallennetun lompakon metatietojen lukeminen epäonnistui"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s'han pogut llegir les metadades de la cartera desada"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nije moguće pročitati spremljene metapodatke novčanika"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepodarilo sa prečítať uložené metadáta peňaženky"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke læse gemte tegnebogs-metadata"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η ανάγνωση των αποθηκευμένων μεταδεδομένων πορτοφολιού"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvestatud rahakoti metaandmete lugemine ebaõnnestus"
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezin izan dira gordetako zorro-metadatuak irakurri"
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Theip ar léamh meiteashonraí an sparáin stóráilte"
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Non se puideron ler os metadatos da carteira gardada"
          }
        },
        "gn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ndaikatúi ohechakuaa metadatos ñongatuha-gua ñeñongatupyre"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "An kasa karanta metadata na walat da ajiye"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Պահված դրամապանակի մետատվյալները կարդալը ձախողվեց"
          }
        },
        "ky": {
          "stringUnit": {
