    "Use biometrics or device credentials for wallet access and sending.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende Biometrie oder Gerätecode für den Wallet-Zugriff und zum Senden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use biometrics or device credentials for wallet access and sending."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa biometría o credenciales del dispositivo para acceder a la cartera y enviar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise la biométrie ou les identifiants de l'appareil pour accéder au portefeuille et envoyer des fonds."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウォレットへのアクセスや送金に生体認証またはデバイス資格情報を使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지갑 접근 및 전송에 생체 인증 또는 기기 자격 증명을 사용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use biometria ou credenciais do dispositivo para acessar a carteira e enviar fundos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте биометрию или учётные данные устройства для доступа к кошельку и отправки средств."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用生物识别或设备凭据来访问钱包和发送资金。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa la biometria o le credenziali del dispositivo per l'accesso al wallet e per l'invio."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik biometrie of apparaatgegevens voor toegang tot de wallet en verzenden."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan biometrik atau kredensial perangkat untuk akses dompet dan pengiriman."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cüzdan erişimi ve gönderim için biyometrik veya cihaz kimlik bilgilerini kullanın."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वॉलेट एक्सेस और भेजने के लिए बायोमेट्रिक्स या डिवाइस क्रेडेंशियल का उपयोग करें।"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用生物識別或設備憑據來訪問錢包和發送資金。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj biometrii lub danych logowania urządzenia do dostępu do portfela i wysyłania."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовуйте біометрію або облікові дані пристрою для доступу до гаманця та надсилання."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sử dụng sinh trắc học hoặc thông tin đăng nhập thiết bị để truy cập ví và gửi tiền."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ไบโอเมตริกหรือข้อมูลรับรองอุปกรณ์สำหรับการเข้าถึงกระเป๋าเงินและการส่งเงิน"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای دسترسی به کیف پول و ارسال، از بیومتریک یا اطلاعات ورود دستگاه استفاده کنید."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro přístup k peněžence a odesílání použijte biometrii nebo přístupové údaje zařízení."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Използвайте биометрия или данни на устройството за достъп до портфейла и изпращане."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använd biometri eller enhetsuppgifter för plånboksåtkomst och sändning."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Folosește date biometrice sau credențiale de dispozitiv pentru accesul la portofel și trimiteri."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk biometri eller enhetsopplysninger for tilgang til lommebok og sending."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم البيانات البيومترية أو بيانات اعتماد الجهاز للوصول إلى المحفظة والإرسال."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השתמש באימות ביומטרי או בפרטי כניסה של המכשיר לגישה לארנק ולשליחה."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo Biometrics tàbí ẹ̀rí ẹ̀rọ fún wíwọlé sí àpamọ́wọ́ àti fífi ránṣẹ́."
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gumamit ng biometrics o device credentials para sa access ng wallet at pagpadala."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ပိုက်ဆံအိတ် ဝင်ရောက်ခြင်းနှင့် ပို့ခြင်းအတွက် Biometrics သို့မဟုတ် device credentials ကို အသုံးပြုပါ။"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan biometrik atau kelayakan peranti untuk akses dompet dan penghantaran."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulqabıya giriş və göndərmə üçün biometrikadan və ya cihaz kimlik məlumatlarından istifadə edin."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ওয়ালেট অ্যাক্সেস এবং পাঠানোর জন্য বায়োমেট্রিক্স বা ডিভাইস ক্রেডেনশিয়াল ব্যবহার করুন।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uporabi biometrijo ali poverilnice naprave za dostop do denarnice in pošiljanje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Használj biometrikus vagy eszközhitelesítő adatot a pénztárcához való hozzáféréshez és a küldéshez."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Naudokite biometriką arba įrenginio duomenis piniginės prieigai ir siuntimui."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Izmantojiet biometriju vai ierīces akreditācijas datus maka piekļuvei un sūtīšanai."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "والٹ تک رسائی اور بھیجنے کے لیے بایومیٹرکس یا ڈیوائس کریڈینشلز استعمال کریں۔"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käytä biometriikkaa tai laitteen tunnistetietoja lompakon käyttöön ja lähettämiseen."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilitza la biometria o les credencials del dispositiu per accedir a la cartera i enviar fons."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koristite biometriju ili vjerodajnice uređaja za pristup novčaniku i slanje."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na prístup k peňaženke a odosielanie použite biometriu alebo prístupové údaje zariadenia."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug biometri eller enhedsoplysninger til adgang til tegnebogen og afsendelse."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρησιμοποιήστε βιομετρικά ή διαπιστευτήρια συσκευής για πρόσβαση στο πορτοφόλι και αποστολή."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasutage rahakotile juurdepääsuks ja saatmiseks biomeetriat või seadme mandaate."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Erabili biometria edo gailuaren kredentzialak zorroa atzitzeko eta bidaltzeko."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Bain úsáid as bithmhéadracht nó dintiúir gléasta le haghaidh rochtain sparáin agus seoladh."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa a biometría ou as credenciais do dispositivo para acceder á carteira e enviar."
          }
        },
        "gn": {
          "stringUnit": {
            "state": "translated",
            "value": "Eiporu biometría térã credencial dispositivo-gua eike hag̃ua ñongatuha-pe ha emondo hag̃ua."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Yi amfani da halittar jiki ko shaidar na'ura don samun damar walat da aikawa."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Օգտագործեք կենսաչափություն կամ սարքի հավատարմագրեր դրամապանակի հասանելիության և ուղարկման համար։"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Капчыкка мүмкүнчүлүк алуу жана жөнөтүү үчүн биометрияны же түзмөк ишеним каттарын колдонуңуз."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Përdor biometrikën ose kredencialet e pajisjes për aksesin te portofoli dhe dërgimin."
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzu biometrion aŭ aparat-akreditaĵojn por atingo al la monujo kaj por sendado."
          }
        }
      }
    },
