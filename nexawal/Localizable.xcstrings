        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tipp: a 0 az egész lánc előzményeit átvizsgálja. Ez a legbiztonságosabb megoldás, ha nem vagy biztos benne, de tovább tarthat a szinkronizálás."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Խորհուրդ՝ 0-ը սկանավորում է ամբողջ շղթայի պատմությունը։ Սա ամենաանվտանգ տարբերակն է, եթե վստահ չեք, բայց համաժամացումն ավելի երկար ժամանակ կպահանջի։"
