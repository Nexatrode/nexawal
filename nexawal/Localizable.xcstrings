          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci il destinatario e l'importo, visualizza l'anteprima della commissione, poi conferma la transazione."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer de ontvanger en het bedrag in, bekijk de vergoeding en bevestig daarna de transactie."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan penerima dan jumlah, pratinjau biaya, lalu konfirmasi transaksi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alıcıyı ve miktarı girin, ücreti önizleyin, ardından işlemi onaylayın."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्राप्तकर्ता और राशि दर्ज करें, फ़ीस का पूर्वावलोकन करें, फिर ट्रांज़ैक्शन की पुष्टि करें।"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入收款人和金額,預覽手續費,然後確認交易。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wprowadź odbiorcę i kwotę, sprawdź opłatę, a następnie potwierdź transakcję."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть отримувача і суму, перегляньте комісію, а потім підтвердьте транзакцію."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập người nhận và số tiền, xem trước phí, sau đó xác nhận giao dịch."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กรอกผู้รับและจำนวนเงิน ดูตัวอย่างค่าธรรมเนียม แล้วยืนยันธุรกรรม"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "گیرنده و مقدار را وارد کنید، کارمزد را پیش‌نمایش کنید، سپس تراکنش را تأیید کنید."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadejte příjemce a částku, zobrazte náhled poplatku a poté potvrďte transakci."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Въведете получателя и сумата, прегледайте таксата, след което потвърдете транзакцията."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ange mottagare och belopp, förhandsgranska avgiften och bekräfta sedan transaktionen."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Introdu destinatarul și suma, previzualizează comisionul, apoi confirmă tranzacția."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Angi mottaker og beløp, forhåndsvis avgiften, og bekreft deretter transaksjonen."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل المستلم والمبلغ، عاين الرسوم، ثم أكّد المعاملة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הזן את הנמען והסכום, הצג תצוגה מקדימה של העמלה, ולאחר מכן אשר את העסקה."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "Kọ ẹni tí yóò gbà àti iye, wo ọya ṣáájú, kí o sì fọwọ́sí ìṣòwò náà."
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilagay ang tatanggap at halaga, i-preview ang bayad, pagkatapos ay kumpirmahin ang transaksyon."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "လက်ခံသူနှင့် ပမာဏကို ထည့်ပါ၊ အခကြေးငွေကို အစမ်းကြည့်ပါ၊ ထို့နောက် ငွေပေးငွေယူမှုကို အတည်ပြုပါ။"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan penerima dan jumlah, pratonton yuran, kemudian sahkan transaksi."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Alıcı və məbləği daxil edin, komissiyaya baxın, sonra əməliyyatı təsdiqləyin."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রাপক এবং পরিমাণ লিখুন, ফি প্রিভিউ দেখুন, তারপর লেনদেন নিশ্চিত করুন।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vnesi prejemnika in znesek, si oglej predogled provizije, nato potrdi transakcijo."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Add meg a címzettet és az összeget, nézd meg a díj előnézetét, majd erősítsd meg a tranzakciót."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Įveskite gavėją ir sumą, peržiūrėkite mokestį, tada patvirtinkite operaciją."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ievadiet saņēmēju un summu, apskatiet maksu un tad apstipriniet transakciju."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "وصول کنندہ اور رقم درج کریں، فیس کا پیش منظر دیکھیں، پھر ٹرانزیکشن کی تصدیق کریں۔"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Syötä vastaanottaja ja määrä, esikatsele maksu ja vahvista sitten tapahtuma."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Introdueix el destinatari i l'import, previsualitza la comissió i després confirma la transacció."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Unesite primatelja i iznos, pregledajte naknadu, a zatim potvrdite transakciju."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadajte príjemcu a sumu, zobrazte náhľad poplatku a potom potvrďte transakciu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Angiv modtager og beløb, forhåndsvis gebyret, og bekræft derefter transaktionen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εισαγάγετε τον παραλήπτη και το ποσό, προεπισκοπήστε την προμήθεια και έπειτα επιβεβαιώστε τη συναλλαγή."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sisestage saaja ja summa, vaadake tasu eelvaadet ning kinnitage seejärel tehing."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Sartu hartzailea eta kopurua, aurreikusi komisioa, eta gero berretsi transakzioa."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuir isteach an faighteoir agus an méid, faigh réamhamharc ar an táille, agus deimhnigh an idirbheart ansin."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce o destinatario e a cantidade, previsualiza a comisión e despois confirma a transacción."
          }
        },
        "gn": {
          "stringUnit": {
            "state": "translated",
            "value": "Emoinge ohupytýva ha cantidad, ehecha mboyve comisión, upéi emoneĩ transacción."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Shigar da mai karɓa da adadin, duba kuɗin caji, sannan ka tabbatar da ma'amalar."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Մուտքագրեք ստացողին և գումարը, նախադիտեք միջնորդավճարը, ապա հաստատեք գործարքը։"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Алуучуну жана сумманы киргизиңиз, комиссияны алдын ала көрүңүз, андан кийин транзакцияны ырастаңыз."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Fut marrësin dhe shumën, shiko paraprakisht tarifën, pastaj konfirmo transaksionin."
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Enigu la ricevanton kaj sumon, antaŭrigardu la krompagon, poste konfirmu la transakcion."
          }
        }
      }
    },
