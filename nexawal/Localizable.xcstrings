    "Show the QR code, copy the address, or create a fresh receive address for better privacy.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeige den QR-Code, kopiere die Adresse oder erstelle eine neue Empfangsadresse für mehr Privatsphäre."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show the QR code, copy the address, or create a fresh receive address for better privacy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra el código QR, copia la dirección o crea una nueva dirección de recepción para más privacidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche le code QR, copie l'adresse ou crée une nouvelle adresse de réception pour plus de confidentialité."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "QRコードを表示したり、アドレスをコピーしたり、より高いプライバシーのために新しい受取用アドレスを作成したりできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "QR 코드를 표시하거나 주소를 복사하거나, 더 나은 개인정보 보호를 위해 새 수신 주소를 만드세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostre o código QR, copie o endereço ou crie um novo endereço de recebimento para mais privacidade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Покажите QR-код, скопируйте адрес или создайте новый адрес получения для лучшей приватности."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示 QR 码、复制地址,或创建新的接收地址以获得更好的隐私保护。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra il codice QR, copia l'indirizzo o crea un nuovo indirizzo di ricezione per una maggiore privacy."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toon de QR-code, kopieer het adres, of maak een nieuw ontvangstadres aan voor meer privacy."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampilkan kode QR, salin alamat, atau buat alamat terima baru untuk privasi yang lebih baik."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "QR kodunu gösterin, adresi kopyalayın veya daha iyi gizlilik için yeni bir alım adresi oluşturun."
          }
        }
      }
    },
