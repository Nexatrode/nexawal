    "Swept max spendable from selected subaddress via %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximal verfügbares Guthaben der ausgewählten Unteradresse über %@ gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swept max spendable from selected subaddress via %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se envió el máximo gastable de la subdirección seleccionada vía %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Solde maximal disponible de la sous-adresse sélectionnée transféré via %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 経由で選択したサブアドレスから送金可能な最大額を送金しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@를 통해 선택한 서브주소에서 최대 지출 가능액을 전송했습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Saldo máximo disponível varrido do subendereço selecionado via %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Максимальный доступный баланс выбранного подадреса выведен через %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已通过 %@ 从所选子地址清空最大可用余额。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Massimo spendibile svuotato dal sottoindirizzo selezionato tramite %@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximaal besteedbaar bedrag verzonden vanaf geselecteerd subadres via %@."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyapu maksimum yang dapat dibelanjakan dari subalamat terpilih melalui %@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçili alt adresten harcanabilir maksimum, %@ üzerinden süpürüldü."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ के माध्यम से चयनित सब-एड्रेस से अधिकतम व्यय-योग्य राशि स्वीप की गई।"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已通過 %@ 從所選子地址清空最大可用餘額。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesłano maksymalne dostępne środki z wybranego podadresu przez %@."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виведено максимальні доступні кошти з вибраної підадреси через %@."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã chuyển toàn bộ số dư khả dụng từ địa chỉ phụ đã chọn qua %@."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โอนยอดคงเหลือสูงสุดที่ใช้จ่ายได้จากที่อยู่ย่อยที่เลือกผ่าน %@ แล้ว"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "حداکثر قابل خرج از زیرآدرس انتخاب‌شده از طریق %@ برداشت شد."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximální disponibilní částka z vybrané podadresy byla odeslána přes %@."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Максималният разполагаем баланс от избрания подадрес беше изпратен през %@."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximalt spenderbart belopp från vald underadress tömdes via %@."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "S-a retras maximul disponibil din subadresa selectată prin %@."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tømte maks tilgjengelig saldo fra valgt underadresse via %@."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تفريغ الحد الأقصى القابل للإرسال من العنوان الفرعي المحدد عبر %@."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הסכום המרבי הניתן לשליחה מכתובת המשנה שנבחרה רוקן באמצעות %@."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "A ti gbá iye tí a lè lò tó pọ̀ jùlọ jọ láti sub-àdírẹ́sì tí a yàn nípasẹ̀ %@."
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nalinis ang max na magagamit mula sa napiling subaddress gamit ang %@."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ရွေးချယ်ထားသော subaddress မှ အသုံးပြုနိုင်သော အများဆုံးကို %@ ဖြင့် စုပယူပြီးပါပြီ။"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Baki maksimum yang boleh dibelanjakan daripada sub-alamat terpilih telah disapu melalui %@."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilmiş alt ünvandan %@ vasitəsilə maksimum sərf edilə bilən məbləğ süpürüldü."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-এর মাধ্যমে নির্বাচিত উপ-ঠিকানা থেকে সর্বোচ্চ ব্যয়যোগ্য পরিমাণ ঝেড়ে নেওয়া হয়েছে।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Največje razpoložljivo stanje izpraznjeno z izbranega podnaslova prek %@."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A maximálisan elkölthető összeg kiürítve a kiválasztott alcímről a %@ útján."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Maksimali išleidžiama suma iš pasirinkto subadreso išsiųsta per %@."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Maksimālā tērējamā summa no izvēlētās subadreses nosūtīta, izmantojot %@."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "منتخب سب ایڈریس سے زیادہ سے زیادہ قابل خرچ رقم %@ کے ذریعے بھیج دی گئی۔"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suurin käytettävissä oleva määrä valitusta aliosoitteesta lähetetty %@:n kautta."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "S'ha escombrat el màxim gastable des de la subadreça seleccionada mitjançant %@."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maksimalno stanje za potrošiti izbrisano je iz odabrane podadrese putem %@."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximálny disponibilný zostatok bol vyzbieraný z vybranej podadresy cez %@."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Maksimalt disponibelt beløb fra valgt underadresse tømt via %@."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το μέγιστο διαθέσιμο για δαπάνη από την επιλεγμένη υποδιεύθυνση εκκαθαρίστηκε μέσω %@."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitud alamaadressilt maksimaalne kulutatav summa tühjendati %@ kaudu."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hautatutako azpihelbidetik gehienezko saldo gastagarria hustu da %@ bidez."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Scuabadh an uasmhéid inchaite ón fho-sheoladh roghnaithe trí %@."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Baleirouse o máximo gastable desde o subenderezo seleccionado mediante %@."
          }
        },
        "gn": {
          "stringUnit": {
            "state": "translated",
            "value": "Oñemondo opa saldo emondorãva subdirección poravopyre-gui %@ rupive."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "An share mafi girman da za a kashe daga sab-adireshin da aka zaɓa ta hanyar %@."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ընտրված ենթահասցեից դատարկվեց առավելագույն ծախսելի գումարը %@-ի միջոցով։"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Тандалган кошумча дарек %@ аркылуу чыгымдалуучу эң чоң сумма тазаланды."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "U fshi maksimumi i shpenzueshëm nga nën-adresa e zgjedhur nëpërmjet %@."
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Forbalaita la maksimuma elspezebla el la elektita subadreso per %@."
          }
        }
      }
    },
