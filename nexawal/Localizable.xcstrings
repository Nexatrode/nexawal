    "Enter the recipient and amount, preview the fee, then confirm the transaction.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib Empfänger und Betrag ein, sieh dir die Gebühr an und bestätige dann die Transaktion."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the recipient and amount, preview the fee, then confirm the transaction."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce el destinatario y la cantidad, previsualiza la comisión y confirma la transacción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisis le destinataire et le montant, vérifie les frais, puis confirme la transaction."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送金先と金額を入力し、手数料を確認してから取引を確定してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "받는 사람과 금액을 입력하고 수수료를 미리 확인한 다음 거래를 확인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite o destinatário e o valor, visualize a taxa e, depois, confirme a transação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите получателя и сумму, просмотрите комиссию, затем подтвердите транзакцию."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入收款人和金额,预览手续费,然后确认交易。"
          }
        },
        "it": {
