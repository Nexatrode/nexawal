    "Device authentication is required but unavailable. Enable biometrics or a screen lock, then retry.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device authentication is required but unavailable. Enable biometrics or a screen lock, then retry."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se requiere autenticación del dispositivo, pero no está disponible. Activa la biometría o un bloqueo de pantalla e inténtalo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A autenticação do dispositivo é necessária, mas está indisponível. Ative a biometria ou um bloqueio de tela e tente novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要设备身份验证,但当前不可用。请启用生物识别或屏幕锁定后重试。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Требуется аутентификация устройства, но она недоступна. Включите биометрию или блокировку экрана и попробуйте снова."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Geräteauthentifizierung ist erforderlich, aber nicht verfügbar. Aktiviere Biometrie oder eine Bildschirmsperre und versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'authentification de l'appareil est requise mais indisponible. Active la biométrie ou un verrouillage d'écran, puis réessaie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイス認証が必要ですが利用できません。生体認証または画面ロックを有効にしてから再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 인증이 필요하지만 사용할 수 없습니다. 생체 인증 또는 화면 잠금을 활성화한 후 다시 시도하세요."
          }
        }
      }
    },
