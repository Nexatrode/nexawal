        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "အခကြေးငွေ ခန့်မှန်းပြီး (input များသည် ရွေးချယ်ထားသော subaddress အတွင်း ကန့်သတ်ထားသည်)။"
