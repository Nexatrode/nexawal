        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Колдонуу шарттарын окуп, макулмун"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Perskaičiau ir sutinku su Naudojimo sąlygomis"
