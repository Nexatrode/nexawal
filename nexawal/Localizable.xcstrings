          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Commissione stimata (input limitati al sottoindirizzo selezionato)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergoeding geschat (invoer beperkt tot geselecteerd subadres)."
          }
        },
        "id": {
