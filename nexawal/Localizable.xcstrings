        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সঠিক রিস্টোর হাইট ব্যবহার করার পরেও ওয়ালেট আমদানি অসম্পূর্ণ মনে হলেই এই মানগুলো পরিবর্তন করুন।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te vrednosti spremeni le, če se uvoz denarnice zdi nepopoln po uporabi pravilne višine za obnovitev."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak akkor módosítsd ezeket az értékeket, ha a pénztárca importálása hiányosnak tűnik a helyes visszaállítási magasság használata után."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šias reikšmes keiskite tik jei piniginės importas atrodo neišsamus panaudojus teisingą atkūrimo aukštį."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mainiet šīs vērtības tikai tad, ja maka imports šķiet nepilnīgs pēc pareiza atjaunošanas augstuma izmantošanas."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "درست ریسٹور ہائٹ استعمال کرنے کے بعد اگر والٹ کی درآمد نامکمل نظر آئے تو ہی یہ قدریں تبدیل کریں۔"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muuta näitä arvoja vain, jos lompakon tuonti näyttää epätäydelliseltä oikean palautuskorkeuden käytön jälkeen."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Canvia aquests valors només si una importació de cartera sembla incompleta després d'utilitzar l'alçada de restauració correcta."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mijenjajte ove vrijednosti samo ako se uvoz novčanika čini nepotpunim nakon korištenja ispravne visine obnove."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieto hodnoty meňte iba v prípade, že sa import peňaženky po použití správnej výšky obnovenia javí ako nekompletný."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skift kun disse værdier, hvis en tegnebogsimport virker ufuldstændig efter brug af den korrekte gendannelseshøjde."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αλλάξτε αυτές τις τιμές μόνο αν μια εισαγωγή πορτοφολιού φαίνεται ελλιπής μετά τη χρήση του σωστού ύψους επαναφοράς."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Muutke neid väärtusi ainult siis, kui rahakoti import näib pärast õige taastamiskõrguse kasutamist ikka poolik."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Aldatu balio hauek soilik zorro-inportazio bat osatugabea badirudi leheneratze-altuera zuzena erabili ondoren."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Athraigh na luachanna seo ach amháin má tá iompórtú sparáin neamhiomlán tar éis duit an airde aisghabhála cheart a úsáid."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia estes valores só se a importación dunha carteira parece incompleta despois de usar a altura de restauración correcta."
          }
        },
        "gn": {
          "stringUnit": {
            "state": "translated",
            "value": "Emyengovia umi valor ko'ãva ñongatuha ñemoinge ohecharamóvo mbykymby'ỹ eiporu rire altura de restauración iporãva."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Canza waɗannan ƙimomi ne kawai idan shigar da walat ta bayyana ba cikakke ba bayan an yi amfani da tsayin dawowa daidai."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Փոփոխեք այս արժեքները միայն այն դեպքում, եթե դրամապանակի ներմուծումը թվում է ամբողջական չլինել ճիշտ վերականգնման բարձրություն կիրառելուց հետո։"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Туура калыбына келтирүү бийиктигин колдонгондон кийин капчык импорту толук эмес көрүнгөн учурда гана бул маанилерди өзгөртүңүз."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Ndrysho këto vlera vetëm nëse një import portofoli duket i paplotë pas përdorimit të lartësisë së saktë të rikuperimit."
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Ŝanĝu ĉi tiujn valorojn nur se importo de monujo ŝajnas nekompleta post uzo de la ĝusta restaŭra alto."
          }
        }
      }
    },
