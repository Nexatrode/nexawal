          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelime(ler) henüz eşleşmiyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Слова ще не збігаються."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "الفاظ ابھی میچ نہیں ہو رہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
