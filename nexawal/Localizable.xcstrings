    "NexaWal by Nexatrode LLC is a self-custodial interface for managing digital assets. You hold exclusive responsibility for your private keys and 25-word seed phrase.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NexaWal by Nexatrode LLC is a self-custodial interface for managing digital assets. You hold exclusive responsibility for your private keys and 25-word seed phrase."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "NexaWal من Nexatrode LLC واجهة ذاتية الحفظ لإدارة الأصول الرقمية. أنت تتحمل المسؤولية الحصرية عن مفاتيحك الخاصة وعبارة الاسترداد المكوّنة من 25 كلمة."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Nexatrode LLC-nin NexaWal-ı rəqəmsal aktivləri idarə etmək üçün özünə saxlama interfeysidir. Şəxsi açarlarınız və 25 sözlük seed ifadəniz üçün müstəsna məsuliyyət sizə aiddir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "NexaWal от Nexatrode LLC е интерфейс със самостоятелно съхранение за управление на цифрови активи. Вие носите изключителна отговорност за частните си ключове и seed фразата от 25 думи."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Nexatrode LLC-এর NexaWal ডিজিটাল সম্পদ পরিচালনার জন্য একটি স্ব-অভিভাবক ইন্টারফেস। আপনার প্রাইভেট কী এবং ২৫-শব্দের সিড বাক্যাংশের সম্পূর্ণ দায়িত্ব আপনার।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "NexaWal de Nexatrode LLC és una interfície d’autocustòdia per gestionar actius digitals. Teniu la responsabilitat exclusiva de les claus privades i de la frase llavor de 25 paraules."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "NexaWal od Nexatrode LLC je self-custodial rozhraní pro správu digitálních aktiv. Výhradní odpovědnost za soukromé klíče a 25slovnou seed frázi neseš ty."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "NexaWal fra Nexatrode LLC er en self-custodial grænseflade til at administrere digitale aktiver. Du har det fulde ansvar for dine private nøgler og 25-ords seed-sætning."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "NexaWal von Nexatrode LLC ist eine selbstverwahrte Schnittstelle zur Verwaltung digitaler Vermögenswerte. Du trägst die alleinige Verantwortung für deine privaten Schlüssel und die 25-Wort-Seed-Phrase."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το NexaWal της Nexatrode LLC είναι μια διεπαφή αυτοφύλαξης για τη διαχείριση ψηφιακών περιουσιακών στοιχείων. Έχετε αποκλειστική ευθύνη για τα ιδιωτικά σας κλειδιά και τη φράση seed 25 λέξεων."
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "NexaWal de Nexatrode LLC estas mem-garda interfaco por administri ciferecajn aktivojn. Vi sole respondecas pri viaj privataj ŝlosiloj kaj 25-vorta semfrazo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "NexaWal de Nexatrode LLC es una interfaz de autocustodia para gestionar activos digitales. Usted tiene la responsabilidad exclusiva de sus claves privadas y de su frase semilla de 25 palabras."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Nexatrode LLC NexaWal on isehoidlik liides digitaalse vara haldamiseks. Kannate ainuisikulist vastutust privaatvõtmete ja 25-sõnalise seemnelause eest."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nexatrode LLC-ren NexaWal auto-zaintzako interfazea da aktibo digitalak kudeatzeko. Zure gako pribatuen eta 25 hitzeko seed esaldiaren erantzukizun esklusiboa duzu."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "NexaWal از Nexatrode LLC یک رابط خودنگهدار برای مدیریت دارایی‌های دیجیتال است. مسئولیت انحصاری کلیدهای خصوصی و عبارت بازیابی ۲۵ کلمه‌ای بر عهده شماست."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nexatrode LLC:n NexaWal on itsehallinnollinen käyttöliittymä digitaalisten varojen hallintaan. Olet yksin vastuussa yksityisavaimistasi ja 25 sanan siemenlauseesta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "NexaWal par Nexatrode LLC est une interface en auto-conservation pour gérer des actifs numériques. Vous êtes seul responsable de vos clés privées et de votre phrase de récupération de 25 mots."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Is comhéadan féinchoimeádta é NexaWal ó Nexatrode LLC chun sócmhainní digiteacha a bhainistiú. Tá freagracht eisiach ort as do phríomheochracha agus as an bhfrása síl 25 focal."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "NexaWal de Nexatrode LLC é unha interface de autocustodia para xestionar activos dixitais. Ten a responsabilidade exclusiva das súas chaves privadas e da frase semente de 25 palabras."
          }
        },
        "gn": {
          "stringUnit": {
            "state": "translated",
            "value": "NexaWal Nexatrode LLC mba'éva ha'e peteĩ interface autocustodia oñangareko hag̃ua mba'e rehegua digital-pe. Ndévoi reñangarekóta ne llave privada ha ne semilla ñe'ẽ 25-pe."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "NexaWal na Nexatrode LLC interface ne na kula da kai don sarrafa kadarorin dijital. Kai ne kaɗai ke da alhakin maɓallan sirri da jimlar iri ta kalmomi 25."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "NexaWal של Nexatrode LLC הוא ממשק בשמירה עצמית לניהול נכסים דיגיטליים. האחריות הבלעדית למפתחות הפרטיים ולביטוי הזרע בן 25 המילים היא שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nexatrode LLC का NexaWal डिजिटल संपत्तियों के प्रबंधन के लिए एक स्व-अभिरक्षा इंटरफ़ेस है। आपकी निजी कुंजियों और 25-शब्द सीड वाक्यांश की पूरी ज़िम्मेदारी आपकी है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "NexaWal tvrtke Nexatrode LLC samostalno je skrbničko sučelje za upravljanje digitalnom imovinom. Isključivo ste odgovorni za svoje privatne ključeve i seed frazu od 25 riječi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Nexatrode LLC NexaWal alkalmazása önőrzésű felület digitális eszközök kezeléséhez. A privát kulcsokért és a 25 szavas seed kifejezésért kizárólag Ön felel."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
