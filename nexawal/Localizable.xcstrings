        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi legis kaj konsentas pri la Uzokondiĉoj"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "He leído y acepto los Términos de uso"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Olen lugenud ja nõustun Kasutustingimustega"
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Erabilera-baldintzak irakurri ditut eta onartzen ditut"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "شرایط استفاده را خوانده‌ام و موافقم"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Olen lukenut Käyttöehdot ja hyväksyn ne"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nabasa ko at sumasang-ayon ako sa Mga Tuntunin ng Paggamit"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J'ai lu et j'accepte les Conditions d'utilisation"
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Tá na Téarmaí Úsáide léite agam agus aontaím leo"
