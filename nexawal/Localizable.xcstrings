            "value": "Anotei a miña semente de recuperación"
          }
        },
        "gn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahai ahupimahague che frase mnemónica"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Na rubuta kalmomin dawowar da"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ես գրի առա իմ վերականգնման բառերը"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Мен калыбына келтирүү сөздөрүмдү жазып алдым"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "E shkrova frazën time të rikuperimit"
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi skribis mian restaŭran semon"
          }
        }
      }
    },
