    "Word(s) don't match yet.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الكلمة (أو الكلمات) غير مطابقة حتى الآن."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Söz(lər) hələ uyğun gəlmir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Думата (думите) все още не съвпадат."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শব্দ(গুলো) এখনও মিলছে না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les paraules encara no coincideixen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Slovo (slova) ještě nesouhlasí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordene matcher ikke endnu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wort/Wörter stimmen noch nicht überein."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι λέξεις δεν ταιριάζουν ακόμη."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Word(s) don't match yet."
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "La vorto(j) ankoraŭ ne kongruas."
