    "NexaWal needs camera access to scan QR codes for sending Monero.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "NexaWal benötigt Kamerazugriff, um QR-Codes zum Senden von Monero zu scannen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NexaWal needs camera access to scan QR codes for sending Monero."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "NexaWal necesita acceso a la cámara para escanear códigos QR al enviar Monero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "NexaWal a besoin d'accéder à la caméra pour scanner les codes QR lors de l'envoi de Monero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "NexaWalはMoneroを送金するためのQRコードをスキャンするのにカメラへのアクセスが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Monero를 전송하기 위해 QR 코드를 스캔하려면 NexaWal에 카메라 접근 권한이 필요합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O NexaWal precisa de acesso à câmera para escanear códigos QR ao enviar Monero."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "NexaWal нужен доступ к камере для сканирования QR-кодов при отправке Monero."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "NexaWal 需要访问相机以扫描用于发送 Monero 的 QR 码。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "NexaWal necessita dell'accesso alla fotocamera per scansionare i codici QR per l'invio di Monero."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "NexaWal heeft cameratoegang nodig om QR-codes te scannen voor het verzenden van Monero."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "NexaWal membutuhkan akses kamera untuk memindai kode QR guna mengirim Monero."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "NexaWal, Monero göndermek için QR kodlarını taramak amacıyla kamera erişimine ihtiyaç duyar."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Monero भेजने के लिए QR कोड स्कैन करने हेतु NexaWal को कैमरा एक्सेस की आवश्यकता है।"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "NexaWal 需要訪問相機以掃描用於發送 Monero 的 QR 碼。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "NexaWal potrzebuje dostępu do kamery, aby skanować kody QR podczas wysyłania Monero."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "NexaWal потребує доступу до камери для сканування QR-кодів під час надсилання Monero."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "NexaWal cần quyền truy cập camera để quét mã QR khi gửi Monero."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "NexaWal ต้องการเข้าถึงกล้องเพื่อสแกนโค้ด QR สำหรับส่ง Monero"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "NexaWal برای اسکن کدهای QR جهت ارسال Monero، به دسترسی دوربین نیاز دارد."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "NexaWal potřebuje přístup ke kameře pro skenování QR kódů při odesílání Monero."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "NexaWal се нуждае от достъп до камерата, за да сканира QR кодове при изпращане на Monero."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "NexaWal behöver kameråtkomst för att skanna QR-koder vid sändning av Monero."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "NexaWal are nevoie de acces la cameră pentru a scana codurile QR la trimiterea de Monero."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "NexaWal trenger kameratilgang for å skanne QR-koder ved sending av Monero."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج NexaWal إلى الوصول إلى الكاميرا لمسح رموز QR عند إرسال Monero."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "NexaWal צריך גישה למצלמה לסריקת קודי QR לשליחת Monero."
          }
        }
      }
    },
    "No biometric information is enrolled on this device.": {
      "localizations": {
        "de": {
