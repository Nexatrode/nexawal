    "When enabled, opening the stored wallet and sending funds will require device authentication.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn aktiviert, sind zum Öffnen der gespeicherten Wallet und zum Senden von Geldern eine Geräteauthentifizierung erforderlich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When enabled, opening the stored wallet and sending funds will require device authentication."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si está activado, abrir la cartera guardada y enviar fondos requerirá autenticación del dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois activée, l'ouverture du portefeuille enregistré et l'envoi de fonds nécessiteront une authentification de l'appareil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効にすると、保存されたウォレットを開く際や資金送付時にデバイス認証が必要になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 옵션을 활성화하면 저장된 지갑을 열거나 자금을 전송할 때 기기 인증이 필요합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando ativado, abrir a carteira armazenada e enviar fundos exigirá autenticação do dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если включено, для открытия сохранённого кошелька и отправки средств потребуется аутентификация устройства."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用后,打开已保存的钱包和发送资金都需要进行设备身份验证。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se attivato, l'apertura del wallet memorizzato e l'invio di fondi richiederanno l'autenticazione del dispositivo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Indien ingeschakeld, is apparaatverificatie vereist om de opgeslagen wallet te openen en tegoeden te verzenden."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika diaktifkan, membuka dompet yang tersimpan dan mengirim dana akan memerlukan autentikasi perangkat."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkinleştirildiğinde, kayıtlı cüzdanı açmak ve fon göndermek cihaz kimlik doğrulaması gerektirir."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सक्षम होने पर, संग्रहित वॉलेट खोलने और फंड भेजने के लिए डिवाइस प्रमाणीकरण आवश्यक होगा।"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啓用後,打開已保存的錢包和發送資金都需要進行設備身份驗證。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy włączone, otwieranie zapisanego portfela i wysyłanie środków będzie wymagać uwierzytelnienia urządzenia."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо увімкнено, відкриття збереженого гаманця та надсилання коштів вимагатиме автентифікації пристрою."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi được bật, việc mở ví đã lưu và gửi tiền sẽ yêu cầu xác thực thiết bị."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อเปิดใช้งาน การเปิดกระเป๋าเงินที่จัดเก็บไว้และการส่งเงินจะต้องยืนยันตัวตนอุปกรณ์"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "وقتی فعال باشد، باز کردن کیف پول ذخیره‌شده و ارسال وجوه به احراز هویت دستگاه نیاز خواهد داشت."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když je zapnuto, otevření uložené peněženky a odesílání prostředků bude vyžadovat ověření zařízení."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Когато е включено, отварянето на запазения портфейл и изпращането на средства ще изисква удостоверяване на устройството."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När detta är aktiverat krävs enhetsautentisering för att öppna den sparade plånboken och skicka tillgångar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Când este activată, deschiderea portofelului salvat și trimiterea de fonduri vor necesita autentificarea dispozitivului."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når dette er aktivert, vil åpning av den lagrede lommeboken og sending av midler kreve enhetsautentisering."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند التفعيل، سيتطلب فتح المحفظة المحفوظة وإرسال الأموال مصادقة الجهاز."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כשמופעל, פתיחת הארנק השמור ושליחת כספים ידרשו אימות מכשיר."
          }
        }
      }
    },
