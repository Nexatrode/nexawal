            "state": "translated",
            "value": "Oni rekomendas ruli aŭ konekti al via propra Monero-nodo. Publikaj defaŭltoj estas nur por komforto."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se recomienda ejecutar o conectarse a su propio nodo de Monero. Los valores públicos predeterminados son solo por comodidad."
