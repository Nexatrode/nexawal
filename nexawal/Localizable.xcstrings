    "Only change scan lookahead if an import appears incomplete after using the right restore height.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändere den Scan-Lookahead nur, wenn ein Import nach Verwendung der richtigen Wiederherstellungshöhe unvollständig erscheint."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only change scan lookahead if an import appears incomplete after using the right restore height."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia el alcance de escaneo solo si una importación parece incompleta tras usar la altura correcta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne modifie l'avance d'analyse que si l'importation semble incomplète après avoir utilisé la bonne hauteur de restauration."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "正しい復元高さを使用した後もインポートが不完全に見える場合にのみ、スキャンの先読み数を変更してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "올바른 복구 높이를 사용한 후에도 가져오기가 불완전해 보일 때만 스캔 선행 조회 값을 변경하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Altere a antecipação de varredura somente se uma importação parecer incompleta após usar a altura de restauração correta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменяйте глубину сканирования только если импорт выглядит неполным после использования правильной высоты восстановления."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅当使用正确的恢复高度后导入仍显示不完整时,才更改扫描预扫数。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifica il lookahead di scansione solo se un'importazione risulta incompleta dopo aver usato l'altezza di ripristino corretta."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wijzig de scan-lookahead alleen als een import onvolledig lijkt na het gebruik van de juiste hersteldhoogte."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ubah lookahead pemindaian hanya jika impor terlihat tidak lengkap setelah menggunakan tinggi pemulihan yang benar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doğru kurtarma yüksekliğini kullandıktan sonra içe aktarma eksik görünüyorsa tarama ileri bakışını değiştirin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सही रिस्टोर हाइट का उपयोग करने के बाद भी यदि इम्पोर्ट अधूरा दिखे, तभी स्कैन लुकअहेड बदलें।"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅當使用正確的恢復高度後導入仍顯示不完整時,才更改掃描預掃數。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmieniaj wyprzedzenie skanowania tylko wtedy, gdy import wydaje się niekompletny po użyciu właściwej wysokości przywracania."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Змінюйте випередження сканування лише якщо імпорт виглядає неповним після використання правильної висоти відновлення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ thay đổi mức quét trước nếu việc nhập ví có vẻ chưa hoàn tất sau khi dùng đúng độ cao khôi phục."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปลี่ยนระยะสแกนล่วงหน้าเฉพาะเมื่อการนำเข้าดูเหมือนไม่สมบูรณ์หลังจากใช้ความสูงการกู้คืนที่ถูกต้องแล้ว"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط در صورتی پیش‌نگری اسکن را تغییر دهید که پس از استفاده از ارتفاع بازیابی درست، وارد کردن ناقص به نظر برسد."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Předstih skenování měňte pouze tehdy, pokud se import po použití správné výšky obnovení jeví jako nekompletní."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Променяйте изпреварващото сканиране само ако импортирането изглежда непълно след използване на правилната височина за възстановяване."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändra endast skanningsförhandstitten om en import verkar ofullständig efter att du använt rätt återställningshöjd."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifică anticiparea de scanare doar dacă un import pare incomplet după folosirea înălțimii de restaurare corecte."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Endre skanneforhåndsvinduet bare hvis en import virker uferdig etter at du har brukt riktig gjenopprettingshøyde."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تغيّر نطاق المسح الاستباقي إلا إذا بدا الاستيراد غير مكتمل بعد استخدام ارتفاع الاستعادة الصحيح."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שנה את טווח הסריקה קדימה רק אם ייבוא נראה לא שלם לאחר השימוש בגובה השחזור הנכון."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "Yí wíwo-iṣíwájú yíyẹ̀wò padà nìkan bí ìgbéwọlé bá dàbí àìpé lẹ́yìn lílo ipele ìpadàbọ̀ tí ó tọ́."
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Baguhin lang ang scan lookahead kung mukhang hindi kumpleto ang import matapos gamitin ang tamang restore height."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "မှန်ကန်သော ပြန်လည်ရယူရန် အမြင့်ကို အသုံးပြုပြီးနောက် ပြန်လည်ရယူမှု မပြည့်စုံဟု ထင်ရသော အခါမှသာ scan lookahead ကို ပြောင်းလဲပါ။"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tukar had lihat awal imbasan hanya jika import kelihatan tidak lengkap selepas menggunakan ketinggian pemulihan yang betul."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Skan üçün irəli baxışı yalnız düzgün bərpa hündürlüyündən istifadə etdikdən sonra idxal natamam görünürsə dəyişdirin."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সঠিক রিস্টোর হাইট ব্যবহার করার পরেও আমদানি অসম্পূর্ণ মনে হলেই স্ক্যান লুকঅ্যাহেড পরিবর্তন করুন।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vnaprejšnje preiskovanje spremeni le, če se uvoz zdi nepopoln po uporabi pravilne višine za obnovitev."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak akkor módosítsd az előretekintést, ha az importálás hiányosnak tűnik a megfelelő visszaállítási magasság használata után."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Skenavimo numatymą keiskite tik jei importas atrodo neišsamus panaudojus tinkamą atkūrimo aukštį."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mainiet skenēšanas meklēšanas diapazonu tikai tad, ja imports šķiet nepilnīgs pēc pareiza atjaunošanas augstuma izmantošanas."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "درست ریسٹور ہائٹ استعمال کرنے کے بعد اگر درآمد نامکمل نظر آئے تو ہی اسکین لُک اہیڈ تبدیل کریں۔"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muuta skannauksen ennakkoa vain, jos tuonti näyttää epätäydelliseltä oikean palautuskorkeuden käytön jälkeen."
          }
        }
      }
    },
    "Only change these values if a wallet import appears incomplete after using the correct restore height.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändere diese Werte nur, wenn ein Wallet-Import nach Verwendung der richtigen Wiederherstellungshöhe unvollständig erscheint."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only change these values if a wallet import appears incomplete after using the correct restore height."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia estos valores solo si la importación parece incompleta tras usar la altura de restauración correcta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne modifie ces valeurs que si l'importation du portefeuille semble incomplète après avoir utilisé la bonne hauteur de restauration."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "正しい復元高さを使用した後もウォレットのインポートが不完全に見える場合にのみ、これらの値を変更してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "올바른 복구 높이를 사용한 후에도 지갑 가져오기가 불완전해 보일 때만 이 값들을 변경하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Altere estes valores somente se a importação de uma carteira parecer incompleta após usar a altura de restauração correta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменяйте эти значения только если импорт кошелька выглядит неполным после использования правильной высоты восстановления."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅当使用正确的恢复高度后钱包导入仍显示不完整时,才更改这些值。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifica questi valori solo se un'importazione del wallet risulta incompleta dopo aver usato l'altezza di ripristino corretta."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wijzig deze waarden alleen als een walletimport onvolledig lijkt na het gebruik van de juiste hersteldhoogte."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ubah nilai-nilai ini hanya jika impor dompet terlihat tidak lengkap setelah menggunakan tinggi pemulihan yang benar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doğru kurtarma yüksekliğini kullandıktan sonra cüzdan içe aktarımı eksik görünüyorsa bu değerleri değiştirin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सही रिस्टोर हाइट का उपयोग करने के बाद भी यदि वॉलेट इम्पोर्ट अधूरा दिखे, तभी इन मूल्यों को बदलें।"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅當使用正確的恢復高度後錢包導入仍顯示不完整時,才更改這些值。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmieniaj te wartości tylko wtedy, gdy import portfela wydaje się niekompletny po użyciu prawidłowej wysokości przywracania."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Змінюйте ці значення лише якщо імпорт гаманця виглядає неповним після використання правильної висоти відновлення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ thay đổi các giá trị này nếu việc nhập ví có vẻ chưa hoàn tất sau khi dùng đúng độ cao khôi phục."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปลี่ยนค่าเหล่านี้เฉพาะเมื่อการนำเข้ากระเป๋าเงินดูเหมือนไม่สมบูรณ์หลังจากใช้ความสูงการกู้คืนที่ถูกต้องแล้ว"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این مقادیر را فقط در صورتی تغییر دهید که پس از استفاده از ارتفاع بازیابی درست، وارد کردن کیف پول ناقص به نظر برسد."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tyto hodnoty měňte pouze tehdy, pokud se import peněženky po použití správné výšky obnovení jeví jako nekompletní."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Променяйте тези стойности само ако импортирането на портфейла изглежда непълно след използване на правилната височина за възстановяване."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändra endast dessa värden om en plånboksimport verkar ofullständig efter att du använt rätt återställningshöjd."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifică aceste valori doar dacă importul unui portofel pare incomplet după folosirea înălțimii de restaurare corecte."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Endre disse verdiene bare hvis en lommebokimport virker uferdig etter at du har brukt riktig gjenopprettingshøyde."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تغيّر هذه القيم إلا إذا بدا استيراد المحفظة غير مكتمل بعد استخدام ارتفاع الاستعادة الصحيح."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שנה ערכים אלה רק אם ייבוא ארנק נראה לא שלם לאחר השימוש בגובה השחזור הנכון."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "Yí àwọn iye wọ̀nyí padà nìkan bí àpamọ́wọ́ tí a gbé wọlé bá dàbí àìpé lẹ́yìn lílo ipele ìpadàbọ̀ tí ó tọ́."
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Baguhin lang ang mga value na ito kung mukhang hindi kumpleto ang import ng wallet matapos gamitin ang tamang restore height."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "မှန်ကန်သော ပြန်လည်ရယူရန် အမြင့်ကို အသုံးပြုပြီးနောက် ပိုက်ဆံအိတ် ပြန်လည်ရယူမှု မပြည့်စုံဟု ထင်ရသော အခါမှသာ ဤတန်ဖိုးများကို ပြောင်းလဲပါ။"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tukar nilai ini hanya jika import dompet kelihatan tidak lengkap selepas menggunakan ketinggian pemulihan yang betul."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dəyərləri yalnız düzgün bərpa hündürlüyündən istifadə etdikdən sonra pulqabı idxalı natamam görünürsə dəyişdirin."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সঠিক রিস্টোর হাইট ব্যবহার করার পরেও ওয়ালেট আমদানি অসম্পূর্ণ মনে হলেই এই মানগুলো পরিবর্তন করুন।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te vrednosti spremeni le, če se uvoz denarnice zdi nepopoln po uporabi pravilne višine za obnovitev."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak akkor módosítsd ezeket az értékeket, ha a pénztárca importálása hiányosnak tűnik a helyes visszaállítási magasság használata után."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šias reikšmes keiskite tik jei piniginės importas atrodo neišsamus panaudojus teisingą atkūrimo aukštį."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mainiet šīs vērtības tikai tad, ja maka imports šķiet nepilnīgs pēc pareiza atjaunošanas augstuma izmantošanas."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "درست ریسٹور ہائٹ استعمال کرنے کے بعد اگر والٹ کی درآمد نامکمل نظر آئے تو ہی یہ قدریں تبدیل کریں۔"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muuta näitä arvoja vain, jos lompakon tuonti näyttää epätäydelliseltä oikean palautuskorkeuden käytön jälkeen."
          }
        }
      }
    },
