        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수수료가 추정되었습니다 (입력이 선택한 서브주소로 제한됨)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Taxa estimada (entradas restritas ao subendereço selecionado)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Комиссия рассчитана (входы ограничены выбранным подадресом)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
